    var CREATE_CUENTA_TOKEN = {{ csrf_token('wallet_cuenta_create')|json_encode|raw }};

    var INST_DATA_URL    = {{ path('grova_wallet_institucion_data', {_locale: app.request.locale})|json_encode|raw }};
