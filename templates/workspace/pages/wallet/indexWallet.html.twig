    var walletDt = null;

    function toast(icon, title) {
        if (!window.Swal) return;
        window.Swal.fire({ toast: true, position: 'top-end', icon: icon, title: title,
            showConfirmButton: false, timer: icon === 'error' ? 9000 : 5000, timerProgressBar: true });
    }

    async function postJson(url, fd) {
        var r = await fetch(url, { method: 'POST', body: fd, credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        var txt = await r.text();
        try { return [r.ok, JSON.parse(txt)]; } catch(e) { return [false, { message: txt }]; }
    }

    /* ── DataTable movimientos ── */
    function initEntriesTable() {
        var el = document.getElementById('wallet-entries-table');
        if (!el || typeof DataTable === 'undefined' || el.dataset.dtInit) return;
        el.dataset.dtInit = '1';

        var locale = {{ app.request.locale|json_encode|raw }};
        var dtLang = locale === 'en'
            ? 'https://cdn.datatables.net/plug-ins/2.1.8/i18n/en-GB.json'
            : 'https://cdn.datatables.net/plug-ins/2.1.8/i18n/es-ES.json';

        walletDt = new DataTable(el, {
            ajax: { url: ENTRIES_URL, dataSrc: 'data' },
            columns: [
                { data: { _: 'fecha', sort: 'fecha_sort' } },
                { data: 'desc' },
                { data: 'categoria', orderable: false },
                { data: 'cuenta', orderable: false },
                { data: 'tipo', orderable: false },
                { data: { _: 'monto', sort: 'monto_sort' }, className: 'text-end' },
                { data: 'ops', orderable: false },
            ],
            language: { url: dtLang },
            pageLength: 20,
            order: [[0, 'desc']],
            layout: { topStart: { pageLength: { menu: [10, 20, 50, -1] } }, topEnd: 'search' },
            initComplete: function() { bindDeleteEntries(); },
            drawCallback:  function() { bindDeleteEntries(); },
        });
    }

    function bindDeleteEntries() {
        document.querySelectorAll('.js-wallet-entry-delete').forEach(function(form) {
            if (form.dataset.bound) return;
            form.dataset.bound = '1';
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                if (!window.Swal) { return; }
                var res = await window.Swal.fire({
                    title: '¿Eliminar movimiento?', icon: 'warning',
                    showCancelButton: true, confirmButtonColor: '#dc3545',
                    confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar'
                });
                if (!res.isConfirmed) return;
                var fd = new FormData();
                fd.append('_token', form.dataset.token);
                var [ok, json] = await postJson(form.dataset.action, fd);
                if (ok && json.success) {
                    toast('success', json.message || 'Eliminado.');
                    if (walletDt) walletDt.ajax.reload(null, false);
                    loadCuentasSaldos();
                } else {
                    toast('error', (json && json.message) || 'Error.');
                }
            });
        });
    }

    /* ── Saldos de cuentas (carga asíncrona) ── */
    async function loadCuentasSaldos() {
        try {
            var r = await fetch(CUENTAS_DATA_URL, { credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
            var json = await r.json();
            (json.data || []).forEach(function(row) {
                var el = document.querySelector('.js-cuenta-saldo[data-cuenta-id="' + row.id + '"]');
                if (!el) return;
                var isCredito = el.dataset.credito === '1';
                var saldo = parseFloat(row.saldo);
                el.textContent = (isCredito ? 'Deuda: ' : '') + row.saldoFmt;
                el.className = 'wallet-cuenta-saldo js-cuenta-saldo ' + (isCredito ? 'tipo-gasto' : (saldo >= 0 ? 'saldo-pos' : 'saldo-neg'));
                el.dataset.cuentaId = row.id;
                el.dataset.credito  = el.dataset.credito;
            });
        } catch(e) {}
    }

