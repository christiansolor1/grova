            fd.append('tipo',             document.getElementById('wallet-cuenta-tipo').value);
            fd.append('saldo_inicial', document.getElementById('wallet-cuenta-saldo-inicial').value);
            fd.append('color',         document.getElementById('wallet-cuenta-color').value);
            fd.append('activo',        document.getElementById('wallet-cuenta-activo').checked ? '1' : '0');

            var [ok, json] = await postJson(url, fd);
