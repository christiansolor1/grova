    (function initIconoPicker() {
        const grid      = document.getElementById('icono-picker-items');
        const hidden    = document.getElementById('cat-icono');
        const preview   = document.getElementById('cat-icono-preview');
        const container = document.getElementById('icono-picker-grid');
        const searchEl  = document.getElementById('icono-picker-search');
        const emptyEl   = document.getElementById('icono-picker-empty');

        function renderIconos(filtro) {
            grid.innerHTML = '';
            const q = (filtro || '').toLowerCase().trim();
            const lista = q
                ? ICONOS_DISPONIBLES.filter(function(entry) { return entry[1].includes(q) || entry[0].includes(q); })
                : ICONOS_DISPONIBLES;

            emptyEl.classList.toggle('d-none', lista.length > 0);

            const selectedIcono = hidden.value;
            lista.forEach(function(entry) {
                const icono = entry[0];
                const activo = icono === selectedIcono;
                const col = document.createElement('div');
                col.className = 'col-auto';
                col.innerHTML = '<button type="button" class="btn btn-sm p-1 js-icono-opt ' + (activo ? 'btn-primary text-white' : 'btn-outline-secondary') + '" data-icono="' + icono + '" title="' + entry[1] + '" style="width:34px;height:34px;"><i class="' + iconoClass(icono) + '"></i></button>';
                grid.appendChild(col);
            });
        }

        renderIconos('');

        searchEl.addEventListener('input', function() { renderIconos(this.value); });

        document.getElementById('btn-icono-picker-toggle').addEventListener('click', function() {
            const abriendo = container.classList.contains('d-none');
            container.classList.toggle('d-none');
            if (abriendo) {
                searchEl.value = '';
                renderIconos('');
                searchEl.focus();
            }
        });

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.js-icono-opt');
            if (btn) {
                const icono = btn.dataset.icono;
                hidden.value = icono;
                preview.className = iconoClass(icono) + ' fs-5';
                container.classList.add('d-none');
                renderIconos(searchEl.value);
                return;
            }
            if (!container.contains(e.target) && e.target.id !== 'btn-icono-picker-toggle') {
                container.classList.add('d-none');
            }
        });
    })();

    document.getElementById('btn-nueva-categoria').addEventListener('click', function() {
        openCatModal('create', {});
    });

    document.getElementById('btn-cat-save').addEventListener('click', async function() {
        var nombre = document.getElementById('cat-nombre').value.trim();
        if (!nombre) { toast('error', 'El nombre es obligatorio.'); return; }

        var mode   = document.getElementById('cat-mode').value;
        var url    = mode === 'edit' ? document.getElementById('cat-edit-url').value : CAT_CREATE_URL;
        var fd     = new FormData();
        fd.append('_token',    document.getElementById('cat-csrf').value);
        fd.append('nombre',    nombre);
        fd.append('tipo',      document.getElementById('cat-tipo').value);
        fd.append('icono',     document.getElementById('cat-icono').value.trim() || 'bi-tag');
        fd.append('color',     document.getElementById('cat-color').value);
        fd.append('parent_id', document.getElementById('cat-parent-id').value);

        var r    = await fetch(url, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        var json = await r.json();
        if (json.success) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-categoria')).hide();
            toast('success', json.message);
            loadCategorias();
            if (mode === 'create' && json.id) {
                allCategories.push(json);
                addOptionToSelects(json);
            }
        } else {
            toast('error', json.message);
        }
    });

    function bindCatEdit() {
        document.querySelectorAll('.js-cat-edit').forEach(function(btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = '1';
            btn.addEventListener('click', function() {
                var editUrl = {{ path('grova_wallet_category_edit', {id: '__ID__', _locale: app.request.locale})|json_encode|raw }}.replace('__ID__', btn.dataset.id);
                openCatModal('edit', {
                    nombre: btn.dataset.nombre, tipo: btn.dataset.tipo,
                    icono: btn.dataset.icono, color: btn.dataset.color,
                    parentId: btn.dataset.parentId ? parseInt(btn.dataset.parentId) : null,
                    excludeId: parseInt(btn.dataset.id),
                    csrf: btn.dataset.tokenEdit, editUrl: editUrl,
                });
            });
        });
    }

    function bindCatDelete() {
        document.querySelectorAll('.js-cat-delete').forEach(function(btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = '1';
            btn.addEventListener('click', async function() {
                var res = await window.Swal.fire({
                    title: '¿Eliminar categoría?',
                    html: '<p class="mb-0 small"><strong>' + btn.dataset.nombre + '</strong> será eliminada. Los movimientos con esta categoría quedarán sin categoría.</p>',
                    icon: 'warning', showCancelButton: true,
                    confirmButtonText: 'Eliminar', cancelButtonText: 'Cancelar', confirmButtonColor: '#ef4444',
                });
                if (!res.isConfirmed) return;
                var fd = new FormData();
                fd.append('_token', btn.dataset.tokenDelete);
                var url = {{ path('grova_wallet_category_delete', {id: '__ID__', _locale: app.request.locale})|json_encode|raw }}.replace('__ID__', btn.dataset.id);
                var r = await fetch(url, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
                var json = await r.json();
                if (json.success) { toast('success', json.message); loadCategorias(); }
                else { toast('error', json.message); }
            });
        });
    }

