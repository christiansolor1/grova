    // ── Transferencias ───────────────────────────────────────────────────────

    var TF_CREATE_URL      = {{ path('grova_wallet_transferencia_create', {_locale: app.request.locale})|json_encode|raw }};
    var TF_DATA_URL        = {{ path('grova_wallet_transferencia_data', {_locale: app.request.locale})|json_encode|raw }};
    var TF_REVERTIR_TPL    = {{ path('grova_wallet_transferencia_revertir', {id: '__ID__', _locale: app.request.locale})|json_encode|raw }};

    function loadTransferencias() {
        fetch(TF_DATA_URL, { credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var lista = document.getElementById('wallet-transferencias-lista');
                if (!data.transferencias || data.transferencias.length === 0) {
                    lista.innerHTML = '<div class="grova-empty-state py-4"><div class="grova-empty-icon"><i class="bi bi-arrow-left-right"></i></div><div class="grova-empty-title">Sin transferencias</div><div class="grova-empty-desc">Las transferencias entre cuentas aparecerán aquí.</div></div>';
                    return;
                }
                var html = '<div class="table-responsive"><table class="table table-sm grova-table mb-0"><thead><tr>'
                    + '<th>Fecha</th><th>Desde</th><th>Hacia</th><th class="text-end">Monto</th><th class="text-end">Comisión</th><th>Concepto</th><th></th>'
                    + '</tr></thead><tbody>';
                data.transferencias.forEach(function(t) {
                    html += '<tr>'
                        + '<td class="text-nowrap">' + t.fecha + '</td>'
                        + '<td>' + t.cuentaOrigen + '</td>'
                        + '<td>' + t.cuentaDestino + '</td>'
                        + '<td class="text-end">' + t.montoFmt + '</td>'
                        + '<td class="text-end">' + (t.comisionFmt ?? '—') + '</td>'
                        + '<td>' + (t.concepto ?? '') + '</td>'
                        + '<td class="text-end"><button type="button" class="btn btn-sm btn-link text-danger p-0 js-tf-revertir" data-id="' + t.id + '" data-token="' + t.tokenRevertir + '" title="Revertir"><i class="bi bi-arrow-counterclockwise"></i></button></td>'
                        + '</tr>';
                });
                html += '</tbody></table></div>';
                lista.innerHTML = html;
            })
            .catch(function() { toast('error', 'Error al cargar transferencias.'); });
    }

    document.getElementById('btn-nueva-transferencia').addEventListener('click', function() {
        document.getElementById('tf-fecha').value    = new Date().toISOString().slice(0, 10);
        document.getElementById('tf-monto').value   = '';
        document.getElementById('tf-origen').value  = '';
        document.getElementById('tf-destino').value = '';
        document.getElementById('tf-comision').value = '0';
        document.getElementById('tf-concepto').value = '';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-transferencia')).show();
    });

    document.getElementById('btn-tf-save').addEventListener('click', async function() {
        var monto = parseFloat(document.getElementById('tf-monto').value);
        if (isNaN(monto) || monto <= 0) { toast('error', 'El monto debe ser mayor a 0.'); return; }

        var origen  = document.getElementById('tf-origen').value;
        var destino = document.getElementById('tf-destino').value;
        if (origen === '' && destino === '') { toast('error', 'Origen y destino no pueden ser ambos Cartera general.'); return; }
        if (origen !== '' && origen === destino) { toast('error', 'Origen y destino no pueden ser la misma cuenta.'); return; }

        var fd = new FormData();
        fd.append('_token',           document.getElementById('tf-csrf').value);
        fd.append('fecha',            document.getElementById('tf-fecha').value);
        fd.append('monto',            monto);
        fd.append('cuenta_origen_id', origen);
        fd.append('cuenta_destino_id', destino);
        fd.append('comision',         document.getElementById('tf-comision').value || '0');
        fd.append('concepto',         document.getElementById('tf-concepto').value.trim());

        var r    = await fetch(TF_CREATE_URL, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        var json = await r.json();
        if (json.success) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-transferencia')).hide();
            toast('success', json.message);
            loadTransferencias();
            loadCuentasSaldos();
        } else {
            toast('error', json.message);
        }
    });

    document.getElementById('wallet-transferencias-lista').addEventListener('click', async function(e) {
        var btn = e.target.closest('.js-tf-revertir');
        if (!btn) return;
        var id    = btn.dataset.id;
        var token = btn.dataset.token;
        var ok = await Swal.fire({
            title: '¿Revertir transferencia?',
            text:  'Se eliminarán los movimientos asociados.',
            icon:  'warning',
            showCancelButton:  true,
            confirmButtonText: 'Sí, revertir',
            cancelButtonText:  'Cancelar',
            confirmButtonColor: '#ef4444'
        });
        if (!ok.isConfirmed) return;

        var url = TF_REVERTIR_TPL.replace('__ID__', id);
        var fd  = new FormData();
        fd.append('_token', token);
        var r    = await fetch(url, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        var json = await r.json();
        if (json.success) {
            toast('success', json.message);
            loadTransferencias();
            loadCuentasSaldos();
        } else {
            toast('error', json.message);
        }
    });

    // ── Instituciones ────────────────────────────────────────────────────────

    var INST_CREATE_TOKEN = {{ csrf_token('wallet_institucion_create')|json_encode|raw }};

    var _instOnDone = null;

    function abrirModalInst(modo, datos) {
        _instOnDone = datos._onDone || null;
        document.getElementById('inst-mode').value         = modo;
        document.getElementById('inst-edit-id').value      = datos.id          || '';
        document.getElementById('inst-nombre').value       = datos.nombre      || '';
        document.getElementById('inst-color').value        = datos.color       || '#64748b';
        document.getElementById('inst-csrf').value         = datos.csrf        || INST_CREATE_TOKEN;
        document.getElementById('inst-delete-token').value = datos.deleteToken || '';
        document.getElementById('modal-inst-title').textContent = modo === 'edit' ? 'Editar institución' : 'Nueva institución';
        document.getElementById('btn-inst-delete').style.display = modo === 'edit' ? '' : 'none';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-institucion')).show();
    }

    function loadInstituciones() {
        fetch(INST_DATA_URL, { credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var lista = document.getElementById('wallet-instituciones-lista');
                var insts = data.instituciones || [];

                // Actualizar select del modal de cuenta
                var sel = document.getElementById('wallet-cuenta-institucion-id');
                var current = sel.value;
                sel.innerHTML = '<option value="">— Sin institución —</option>';
                insts.forEach(function(i) {
                    var opt = document.createElement('option');
                    opt.value = i.id; opt.textContent = i.nombre;
                    if (String(i.id) === String(current)) opt.selected = true;
                    sel.appendChild(opt);
                });

                if (insts.length === 0) {
                    lista.innerHTML = '<div class="grova-empty-state py-4"><div class="grova-empty-icon"><i class="bi bi-bank2"></i></div><div class="grova-empty-title">Sin instituciones</div><div class="grova-empty-desc">Agregá tus bancos o cooperativas.</div></div>';
                    return;
                }

                var html = '<div class="table-responsive"><table class="table table-sm grova-table mb-0"><thead><tr><th>Color</th><th>Nombre</th><th></th></tr></thead><tbody>';
                insts.forEach(function(i) {
                    html += '<tr>'
                        + '<td><span style="display:inline-block;width:16px;height:16px;border-radius:50%;background:' + i.color + ';"></span></td>'
                        + '<td><a href="' + i.detalleUrl + '" class="text-decoration-none fw-semibold">' + i.nombre + '</a></td>'
                        + '<td class="text-end d-flex gap-2 justify-content-end">'
                        +   '<button type="button" class="btn btn-sm btn-link p-0 text-secondary js-inst-edit" data-id="' + i.id + '" data-nombre="' + i.nombre + '" data-color="' + i.color + '" data-csrf="' + i.editToken + '" data-delete-token="' + i.deleteToken + '" title="Editar"><i class="bi bi-pencil"></i></button>'
                        +   '<button type="button" class="btn btn-sm btn-link p-0 text-danger js-inst-delete" data-id="' + i.id + '" data-nombre="' + i.nombre + '" data-delete-token="' + i.deleteToken + '" title="Eliminar"><i class="bi bi-trash3"></i></button>'
                        + '</td>'
                        + '</tr>';
                });
                html += '</tbody></table></div>';
                lista.innerHTML = html;
            });
    }

    document.getElementById('btn-nueva-inst').addEventListener('click', function() {
        abrirModalInst('create', {});
    });

    document.getElementById('btn-nueva-inst-inline').addEventListener('click', function() {
        var modalInst = document.getElementById('modal-institucion');
        modalInst.style.zIndex = '1080';

        // Asegurar que el backdrop de la inst quede encima también
        modalInst.addEventListener('shown.bs.modal', function() {
            var backdrops = document.querySelectorAll('.modal-backdrop');
            if (backdrops.length > 1) {
                backdrops[backdrops.length - 1].style.zIndex = '1075';
            }
        }, { once: true });

        modalInst.addEventListener('hidden.bs.modal', function() {
            modalInst.style.zIndex = '';
            loadInstituciones();
        }, { once: true });

        abrirModalInst('create', {});
    });

    document.getElementById('wallet-instituciones-lista').addEventListener('click', async function(e) {
        var btnEdit = e.target.closest('.js-inst-edit');
        if (btnEdit) {
            abrirModalInst('edit', {
                id:          btnEdit.dataset.id,
                nombre:      btnEdit.dataset.nombre,
                color:       btnEdit.dataset.color,
                csrf:        btnEdit.dataset.csrf,
                deleteToken: btnEdit.dataset.deleteToken,
            });
            return;
        }

        var btnDel = e.target.closest('.js-inst-delete');
        if (!btnDel) return;

        var ok = await Swal.fire({
            title: '¿Eliminar "' + btnDel.dataset.nombre + '"?',
            text:  'Las cuentas asociadas quedarán sin institución.',
            icon:  'warning', showCancelButton: true,
            confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar',
            confirmButtonColor: '#ef4444'
        });
        if (!ok.isConfirmed) return;

        var fd = new FormData();
        fd.append('_token', btnDel.dataset.deleteToken);
        var r    = await fetch(INST_DELETE_URL_TPL.replace('__ID__', btnDel.dataset.id), { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        var json = await r.json();
        if (json.success) { toast('success', json.message); loadInstituciones(); }
        else { toast('error', json.message); }
    });

    document.getElementById('btn-inst-save').addEventListener('click', async function() {
        var nombre = document.getElementById('inst-nombre').value.trim();
        if (!nombre) { toast('error', 'El nombre es obligatorio.'); return; }

        var mode = document.getElementById('inst-mode').value;
        var id   = document.getElementById('inst-edit-id').value;
        var url  = mode === 'edit' ? INST_EDIT_URL_TPL.replace('__ID__', id) : INST_CREATE_URL;

        var fd = new FormData();
        fd.append('_token', document.getElementById('inst-csrf').value);
        fd.append('nombre', nombre);
        fd.append('color',  document.getElementById('inst-color').value);

        var r    = await fetch(url, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        var txt  = await r.text();
        var json;
        try { json = JSON.parse(txt); } catch(e) { console.error('Resp inst:', txt); toast('error', 'Error inesperado.'); return; }
        if (json.success) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-institucion')).hide();
            toast('success', json.message);
            if (_instOnDone) {
                var cb = _instOnDone;
                _instOnDone = null;
                document.getElementById('modal-institucion').addEventListener('hidden.bs.modal', function() {
                    cb(json.id || null);
                }, { once: true });
            } else {
                loadInstituciones();
            }
        } else {
            toast('error', json.message);
        }
    });

    document.getElementById('btn-inst-delete').addEventListener('click', async function() {
        var id          = document.getElementById('inst-edit-id').value;
        var deleteToken = document.getElementById('inst-delete-token').value;

        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-institucion')).hide();

        var ok = await Swal.fire({
            title: '¿Eliminar institución?',
            text:  'Las cuentas asociadas quedarán sin institución.',
            icon:  'warning', showCancelButton: true,
            confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar',
            confirmButtonColor: '#ef4444'
        });
        if (!ok.isConfirmed) return;

        var fd = new FormData();
        fd.append('_token', deleteToken);
        var r    = await fetch(INST_DELETE_URL_TPL.replace('__ID__', id), { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        var json = await r.json();
        if (json.success) {
            toast('success', json.message);
            loadInstituciones();
        } else {
            toast('error', json.message);
        }
    });

    // Repoblar select cuando se abre el modal de cuenta
    document.getElementById('modal-wallet-cuenta').addEventListener('show.bs.modal', function() {
        loadInstituciones();
    });

    document.addEventListener('DOMContentLoaded', function() {
        initEntriesTable();
        loadCuentasSaldos();
        bindCuentaModal();
        bindCuentaDelete();
        bindNuevoMovimiento();
        loadGastosFijos();
        loadCategorias();
        loadTransferencias();
        loadInstituciones();
    });
})();
</script>
{% endblock %}
