    // ── Color palette ────────────────────────────────────────────────────────
    const COLORES_PALETA = [
        '#ef4444','#f97316','#f59e0b','#eab308','#84cc16',
        '#22c55e','#10b981','#14b8a6','#06b6d4','#3b82f6',
        '#6366f1','#8b5cf6','#a855f7','#ec4899','#f43f5e',
        '#64748b','#6b7280','#78716c','#0ea5e9','#d97706',
    ];

    function setColorActivo(hex) {
        document.getElementById('cat-color').value = hex;
        document.getElementById('cat-color-preview').style.background = hex;
        document.getElementById('cat-color-hex').textContent = hex;
    }

    function getColoresUsados(excludeId) {
        const usados = new Set();
        document.querySelectorAll('#wallet-categorias-lista [data-color]').forEach(function(el) {
            if (excludeId && el.dataset.id === String(excludeId)) return;
            usados.add(el.dataset.color);
        });
        return usados;
    }

    function renderColorPalette(colorActivo, excludeId) {
        const paleta  = document.getElementById('cat-color-palette');
        const usados  = getColoresUsados(excludeId);
        paleta.innerHTML = '';
        COLORES_PALETA.forEach(function(hex) {
            if (usados.has(hex)) return; // ya está en uso
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'js-color-opt rounded border-0';
            btn.dataset.color = hex;
            btn.style.cssText = 'width:22px;height:22px;background:' + hex + ';cursor:pointer;outline:' + (hex === colorActivo ? '2px solid #1d4ed8' : 'none') + ';outline-offset:1px;';
            btn.title = hex;
            paleta.appendChild(btn);
        });
    }

    document.getElementById('cat-color-palette').addEventListener('click', function(e) {
        const btn = e.target.closest('.js-color-opt');
        if (!btn) return;
        setColorActivo(btn.dataset.color);
        document.querySelectorAll('.js-color-opt').forEach(function(b) {
            b.style.outline = b.dataset.color === btn.dataset.color ? '2px solid #1d4ed8' : 'none';
        });
    });

    document.getElementById('cat-color').addEventListener('input', function() {
        setColorActivo(this.value);
        document.querySelectorAll('.js-color-opt').forEach(function(b) { b.style.outline = 'none'; });
    });

    document.getElementById('btn-color-random').addEventListener('click', function() {
        const excludeId = document.getElementById('cat-mode').value === 'edit'
            ? parseInt(document.getElementById('cat-edit-url').value.match(/\/(\d+)\/edit/)?.[1]) || null
            : null;
        const usados    = getColoresUsados(excludeId);
        const disponibles = COLORES_PALETA.filter(function(c) { return !usados.has(c); });
        if (!disponibles.length) { return; }
        const random = disponibles[Math.floor(Math.random() * disponibles.length)];
        setColorActivo(random);
        renderColorPalette(random, excludeId);
    });

    // ── Icon picker ─────────────────────────────────────────────────────────
    // Formato: si empieza con 'fa-' se usa tal cual (Font Awesome), sino se antepone 'bi ' (Bootstrap Icons)
    function iconoClass(icono) {
        return icono.startsWith('fa-') ? icono : 'bi ' + icono;
