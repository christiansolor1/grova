                document.getElementById('wallet-cuenta-saldo-inicial').value    = btn.dataset.saldoInicial;
                document.getElementById('wallet-cuenta-color').value            = btn.dataset.color;
                document.getElementById('wallet-cuenta-activo').checked         = btn.dataset.activo === '1';
            } else {
                document.getElementById('wallet-cuenta-edit-url').value         = '';
                document.getElementById('wallet-cuenta-csrf').value             = CREATE_CUENTA_TOKEN;
                document.getElementById('wallet-cuenta-nombre').value           = '';
                document.getElementById('wallet-cuenta-institucion-id').value   = '';
                document.getElementById('wallet-cuenta-numero-cuenta').value    = '';
                document.getElementById('wallet-cuenta-tarjeta-digitos').value  = '';
                document.getElementById('wallet-cuenta-tipo').value             = 'debito';
                document.getElementById('wallet-cuenta-saldo-inicial').value    = '0';
                document.getElementById('wallet-cuenta-color').value            = '#64748b';
                document.getElementById('wallet-cuenta-activo').checked         = true;
