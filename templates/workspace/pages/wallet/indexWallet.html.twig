        document.getElementById('btn-wallet-cuenta-save').addEventListener('click', async function() {
            var nombre = document.getElementById('wallet-cuenta-nombre').value.trim();
            if (!nombre) { toast('warning', 'El nombre es obligatorio.'); return; }

            var mode = document.getElementById('wallet-cuenta-mode').value;
            var url  = mode === 'edit' ? document.getElementById('wallet-cuenta-edit-url').value : CREATE_CUENTA_URL;

            var fd = new FormData();
            fd.append('_token',        document.getElementById('wallet-cuenta-csrf').value);
            fd.append('nombre',        nombre);
            fd.append('institucion_id',   document.getElementById('wallet-cuenta-institucion-id').value);
