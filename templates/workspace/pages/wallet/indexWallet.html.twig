        var modal = document.getElementById('modal-wallet-cuenta');
        if (!modal || modal.dataset.bound) return;
        modal.dataset.bound = '1';

        modal.addEventListener('show.bs.modal', function(ev) {
            var btn    = ev.relatedTarget;
            var isEdit = btn && btn.classList.contains('js-wallet-cuenta-edit');
            document.getElementById('modal-wallet-cuenta-title').textContent = isEdit ? 'Editar cuenta' : 'Nueva cuenta';
            document.getElementById('wallet-cuenta-mode').value = isEdit ? 'edit' : 'create';
            document.querySelector('.js-wallet-cuenta-activo-row').style.display = isEdit ? '' : 'none';

            if (isEdit) {
                document.getElementById('wallet-cuenta-edit-url').value      = btn.dataset.editUrl;
                document.getElementById('wallet-cuenta-csrf').value          = btn.dataset.editToken;
                document.getElementById('wallet-cuenta-nombre').value          = btn.dataset.nombre;
                document.getElementById('wallet-cuenta-institucion-id').value  = btn.dataset.institucionId || '';
                document.getElementById('wallet-cuenta-numero-cuenta').value    = btn.dataset.numeroCuenta || '';
                document.getElementById('wallet-cuenta-tarjeta-digitos').value  = btn.dataset.tarjetaDigitos || '';
