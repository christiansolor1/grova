    // ── Rebuild category selects con optgroups ───────────────────────────────
    function rebuildCategorySelects(categories) {
        ['gf-category-id', 'wallet-category'].forEach(function(selId) {
            var sel = document.getElementById(selId);
            if (!sel) { return; }
            var currentVal = sel.value;
            // Conservar solo el primer option vacío
            while (sel.options.length > 1) { sel.remove(1); }

            // Separar raíces con hijos, raíces sin hijos, y subcategorías
            var raicesConHijos = {};
            categories.forEach(function(c) {
                if (c.parentId) { raicesConHijos[c.parentId] = true; }
            });

            // Agrupar
            var grupos = {};   // parentId → hijos[]
            var sueltas = [];  // raíces sin hijos
            categories.forEach(function(c) {
                if (!c.parentId) {
                    if (raicesConHijos[c.id]) {
                        grupos[c.id] = grupos[c.id] || { parent: c, hijos: [] };
                    } else {
                        sueltas.push(c);
                    }
                } else {
                    grupos[c.parentId] = grupos[c.parentId] || { parent: null, hijos: [] };
                    grupos[c.parentId].hijos.push(c);
                }
            });

            // Agregar raíces con subcategorías como optgroup
            Object.values(grupos).forEach(function(g) {
                if (!g.parent) { return; }
                var grp = document.createElement('optgroup');
                grp.label = g.parent.icono ? g.parent.nombre : g.parent.nombre;
                // La raíz misma también es seleccionable
                var optParent = document.createElement('option');
                optParent.value = g.parent.id;
                optParent.textContent = g.parent.nombre;
                grp.appendChild(optParent);
                g.hijos.forEach(function(h) {
                    var opt = document.createElement('option');
                    opt.value = h.id;
                    opt.textContent = '› ' + h.nombre;
                    grp.appendChild(opt);
                });
                sel.appendChild(grp);
            });

            // Raíces sin hijos al final
            sueltas.forEach(function(c) {
                var opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = c.nombre;
                sel.appendChild(opt);
            });

            sel.value = currentVal;
        });
    }

    function addOptionToSelects(cat) {
        var id     = cat.id;
        var nombre = cat.nombreCompleto || cat.nombre;
        ['gf-category-id', 'wallet-category'].forEach(function(selId) {
            var sel = document.getElementById(selId);
            if (!sel) { return; }
            var opt = document.createElement('option');
            opt.value = id;
            opt.textContent = cat.parentId ? '› ' + cat.nombre : cat.nombre;
            opt.selected = true;
            sel.appendChild(opt);
        });
    }

    // ── Poblar select de padre en modal de categoría ─────────────────────────
    function rebuildParentSelect(categories, currentParentId, editId) {
        var sel = document.getElementById('cat-parent-id');
        while (sel.options.length > 1) { sel.remove(1); }
        categories.filter(function(c) {
            return !c.parentId && c.id !== editId;  // solo raíces, no la propia
        }).forEach(function(c) {
            var opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.nombre;
            if (c.id === currentParentId) { opt.selected = true; }
            sel.appendChild(opt);
        });
        sel.value = currentParentId || '';
        // Ocultar tipo si hay padre seleccionado (hereda del padre)
        document.getElementById('cat-tipo-row').style.display = sel.value ? 'none' : '';
    }

    document.getElementById('cat-parent-id').addEventListener('change', function() {
        document.getElementById('cat-tipo-row').style.display = this.value ? 'none' : '';
    });

    function openCatModal(mode, data) {
        document.getElementById('cat-mode').value  = mode;
        document.getElementById('modal-categoria-title').textContent = mode === 'create' ? 'Nueva categoría' : 'Editar categoría';
        document.getElementById('cat-nombre').value = data.nombre || '';
        document.getElementById('cat-tipo').value   = data.tipo || 'gasto';
        const iconoActivo = data.icono || 'bi-tag';
        document.getElementById('cat-icono').value  = iconoActivo;
        document.getElementById('cat-icono-preview').className = iconoClass(iconoActivo) + ' fs-5';
        document.querySelectorAll('.js-icono-opt').forEach(function(b) {
            const activo = b.dataset.icono === iconoActivo;
            b.classList.toggle('btn-primary', activo);
            b.classList.toggle('text-white',  activo);
            b.classList.toggle('btn-outline-secondary', !activo);
        });
        document.getElementById('icono-picker-grid').classList.add('d-none');
        const colorActivo = data.color || '#64748b';
        setColorActivo(colorActivo);
        renderColorPalette(colorActivo, data.excludeId || null);
        document.getElementById('cat-csrf').value   = data.csrf || CAT_CREATE_TOKEN;
        document.getElementById('cat-edit-url').value = data.editUrl || '';
        rebuildParentSelect(allCategories, data.parentId || null, data.excludeId || null);
        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-categoria')).show();
