{% extends 'workspace/app_layout.html.twig' %}
{% block page_title %}Wallet{% endblock %}
{% block app_page_subtitle %}Control de ingresos, gastos y saldo personal.{% endblock %}

{% block page_styles %}
<style>
/* ── Tipo desc ── */
#gf-tipo-desc { transition: opacity .15s; }
body.light-mode #gf-tipo-desc { background:#f1f5f9; color:#475569; }
/* ── Day picker ── */
.gf-day-picker { display:flex; flex-wrap:wrap; gap:3px; }
.gf-day-picker .dp-btn { width:26px; height:26px; display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:500; cursor:pointer; border-radius:5px; background:#1e293b; border:1px solid #334155; color:#94a3b8; transition:background .1s, color .1s; padding:0; }
body.light-mode .gf-day-picker .dp-btn { background:#f1f5f9; border-color:#cbd5e1; color:#64748b; }
.gf-day-picker .dp-btn:hover { background:#334155; color:#e2e8f0; }
body.light-mode .gf-day-picker .dp-btn:hover { background:#e2e8f0; color:#0f172a; }
.gf-day-picker .dp-btn.dp-active { background:#3b82f6; border-color:#3b82f6; color:#fff; font-weight:700; }
.gf-day-picker .dp-btn.dp-clear { width:auto; padding:0 8px; font-size:10px; color:#64748b; }
.gf-day-picker .dp-btn.dp-clear.dp-active { background:#475569; border-color:#475569; color:#fff; }
.wallet-stat { background:#111827; border:1px solid #1e293b; border-radius:12px; padding:1.25rem; }
body.light-mode .wallet-stat { background:#fff; border-color:#e2e8f0; }
.wallet-stat-label { font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.35rem; }
.wallet-stat-value { font-size:26px; font-weight:800; line-height:1; }
.wallet-stat-sub { font-size:12px; color:#64748b; margin-top:.35rem; }
.saldo-pos { color:#22c55e; }
.saldo-neg { color:#f87171; }
.tipo-ingreso { color:#22c55e; }
.tipo-gasto   { color:#f87171; }
.cat-chip { display:inline-flex; align-items:center; gap:.3rem; font-size:11px; padding:2px 8px; border-radius:20px; background:#1e293b; color:#94a3b8; }
body.light-mode .cat-chip { background:#f1f5f9; color:#475569; }
.cuenta-chip { display:inline-flex; align-items:center; font-size:11px; padding:2px 8px; border-radius:20px; border:1px solid; color:#94a3b8; }
/* Tarjetas de cuentas */
.wallet-cuenta-card { background:#111827; border:1px solid #1e293b; border-radius:10px; padding:1rem 1rem .9rem; position:relative; transition:border-color .15s; }
body.light-mode .wallet-cuenta-card { background:#fff; border-color:#e2e8f0; }
.wallet-cuenta-card:hover { border-color:rgba(100,116,139,.5); }
.wallet-cuenta-tipo { font-size:10px; text-transform:uppercase; letter-spacing:.06em; color:#64748b; margin-bottom:.15rem; }
.wallet-cuenta-nombre { font-size:14px; font-weight:700; color:#f8fafc; margin-bottom:.1rem; }
body.light-mode .wallet-cuenta-nombre { color:#0f172a; }
.wallet-cuenta-inst { font-size:11px; color:#64748b; margin-bottom:.5rem; }
.wallet-cuenta-saldo { font-size:20px; font-weight:800; }
.wallet-cuenta-ops { position:absolute; top:.55rem; right:.55rem; display:flex; gap:.2rem; }
</style>
{% endblock %}

{% block app_main %}

{# ── Stats globales ── #}
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="wallet-stat">
            <div class="wallet-stat-label">Saldo cartera</div>
            <div class="wallet-stat-value {{ saldo >= 0 ? 'saldo-pos' : 'saldo-neg' }}">
                L {{ saldo|number_format(2, '.', ',') }}
            </div>
            <div class="wallet-stat-sub">movimientos sin cuenta asignada</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="wallet-stat">
            <div class="wallet-stat-label">Ingresos — {{ mes_label }}</div>
            <div class="wallet-stat-value tipo-ingreso">L {{ ingresos_mes|number_format(2, '.', ',') }}</div>
            <div class="wallet-stat-sub">este mes</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="wallet-stat">
            <div class="wallet-stat-label">Gastos — {{ mes_label }}</div>
            <div class="wallet-stat-value tipo-gasto">L {{ gastos_mes|number_format(2, '.', ',') }}</div>
            <div class="wallet-stat-sub">balance mes: L {{ (ingresos_mes - gastos_mes)|number_format(2, '.', ',') }}</div>
        </div>
    </div>
</div>

{# ── Cuentas ── #}
<div class="content-card mb-4">
    <div class="content-card-header">
        Cuentas
        <div class="d-flex align-items-center gap-2">
            <a href="{{ path('grova_wallet_banca', {_locale: app.request.locale}) }}" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-bank me-1"></i>Banca
            </a>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modal-wallet-cuenta">
                <i class="bi bi-plus-lg me-1"></i>Nueva cuenta
            </button>
        </div>
    </div>
    <div class="content-card-body">
        {% if cuentas|length == 0 %}
        <div class="grova-empty-state py-4">
            <div class="grova-empty-icon"><i class="bi bi-bank2"></i></div>
            <div class="grova-empty-title">Sin cuentas</div>
            <div class="grova-empty-desc">Agregá tus cuentas de banco, cooperativa o efectivo.</div>
        </div>
        {% else %}
        <div class="row g-3">
            {% for cuenta in cuentas %}
            <div class="col-sm-6 col-lg-4" id="wallet-cuenta-col-{{ cuenta.id }}">
                <div class="wallet-cuenta-card" style="border-top:3px solid {{ cuenta.color }};">
                    <div class="wallet-cuenta-ops">
                        <a href="{{ path('grova_wallet_cuenta_detalle', {id: cuenta.id, _locale: app.request.locale}) }}"
                           class="btn btn-sm btn-link p-0 text-secondary"
                           title="Ver estado de cuenta"><i class="bi bi-eye"></i></a>
                        <button type="button"
                                class="btn btn-sm btn-link p-0 text-secondary js-wallet-cuenta-edit"
                                data-cuenta-id="{{ cuenta.id }}"
                                data-nombre="{{ cuenta.nombre }}"
                                data-institucion-id="{{ cuenta.institucion ? cuenta.institucion.id : '' }}"
                                data-numero-cuenta="{{ cuenta.numeroCuenta ? cuenta.numeroCuenta|decrypt : '' }}"
                                data-tarjeta-digitos="{{ cuenta.tarjetaDigitos ? cuenta.tarjetaDigitos|decrypt : '' }}"
                                data-tipo="{{ cuenta.tipo }}"
                                data-saldo-inicial="{{ cuenta.saldoInicial }}"
                                data-color="{{ cuenta.color }}"
                                data-activo="{{ cuenta.isActivo ? '1' : '0' }}"
                                data-edit-token="{{ csrf_token('wallet_cuenta_edit_' ~ cuenta.id) }}"
                                data-edit-url="{{ path('grova_wallet_cuenta_edit', {id: cuenta.id, _locale: app.request.locale}) }}"
                                data-bs-toggle="modal" data-bs-target="#modal-wallet-cuenta"
                                title="Editar"><i class="bi bi-pencil"></i></button>
                        <button type="button"
                                class="btn btn-sm btn-link p-0 text-danger js-wallet-cuenta-delete"
                                data-cuenta-id="{{ cuenta.id }}"
                                data-nombre="{{ cuenta.nombre }}"
                                data-delete-token="{{ csrf_token('wallet_cuenta_delete_' ~ cuenta.id) }}"
                                data-delete-url="{{ path('grova_wallet_cuenta_delete', {id: cuenta.id, _locale: app.request.locale}) }}"
                                title="Eliminar"><i class="bi bi-trash3"></i></button>
                    </div>
                    <div class="wallet-cuenta-tipo">{{ cuenta.tipoLabel }}</div>
                    <div class="wallet-cuenta-nombre">{{ cuenta.nombre }}</div>
                    {% if cuenta.institucion %}
                    <div class="wallet-cuenta-inst">
                        <a href="{{ path('grova_wallet_institucion_detalle', {id: cuenta.institucion.id, _locale: app.request.locale}) }}"
                           class="text-decoration-none text-muted small">
                            <i class="bi bi-bank me-1"></i>{{ cuenta.institucion.nombre }}
                        </a>
                    </div>
                    {% endif %}
                    <div class="wallet-cuenta-saldo js-cuenta-saldo" data-cuenta-id="{{ cuenta.id }}" data-credito="{{ cuenta.isCredito ? '1' : '0' }}">
                        <span class="text-muted small"><i class="bi bi-arrow-repeat"></i></span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# ── Instituciones ── #}
<div class="content-card mb-4">
    <div class="content-card-header">
        Instituciones
        <button type="button" class="btn btn-sm btn-primary" id="btn-nueva-inst">
            <i class="bi bi-plus-lg me-1"></i>Nueva
        </button>
    </div>
    <div class="content-card-body p-0">
        <div id="wallet-instituciones-lista"></div>
    </div>
</div>

{# ── Categorías ── #}
<div class="content-card mb-4">
    <div class="content-card-header">
        Categorías
        <button type="button" class="btn btn-sm btn-primary" id="btn-nueva-categoria">
            <i class="bi bi-plus-lg me-1"></i>Nueva
        </button>
    </div>
    <div class="content-card-body p-0">
        <div id="wallet-categorias-lista"></div>
    </div>
</div>

{# ── Modal Categoría ── #}
<div class="modal fade grova-modal--macos" id="modal-categoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="modal-categoria-title">Nueva categoría</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="cat-mode" value="create">
                <input type="hidden" id="cat-edit-url" value="">
                <input type="hidden" id="cat-csrf" value="{{ csrf_token('wallet_category_create') }}">
                <div class="mb-2">
                    <label class="form-label small mb-1">Categoría padre <small class="text-muted">(opcional)</small></label>
                    <select id="cat-parent-id" class="form-select form-select-sm">
                        <option value="">— Ninguna (categoría raíz) —</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label small mb-1">Nombre <span class="text-danger">*</span></label>
                    <input type="text" id="cat-nombre" class="form-control form-control-sm" placeholder="Ej: Alimentos, Agua, Netflix" maxlength="80">
                </div>
                <div class="row g-2 mb-3" id="cat-tipo-row">
                    <div class="col-6">
                        <label class="form-label small mb-1">Tipo</label>
                        <select id="cat-tipo" class="form-select form-select-sm">
                            <option value="gasto">Gasto</option>
                            <option value="ingreso">Ingreso</option>
                        </select>
                    </div>
                    <div class="col-12 mt-1">
                        <label class="form-label small mb-1">Color</label>
                        <div class="d-flex flex-wrap gap-1 align-items-center mb-1" id="cat-color-palette"></div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-color-random" title="Color aleatorio disponible"><i class="bi bi-shuffle"></i></button>
                            <input type="color" id="cat-color" class="form-control form-control-color form-control-sm" value="#64748b" style="width:36px;height:30px;padding:2px;" title="Color personalizado">
                            <span id="cat-color-preview" class="rounded" style="width:22px;height:22px;display:inline-block;border:1px solid #ccc;background:#64748b;"></span>
                            <span class="text-muted small" id="cat-color-hex">#64748b</span>
                        </div>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Ícono</label>
                    <input type="hidden" id="cat-icono" value="bi-tag">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="input-group-text rounded" style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;">
                            <i id="cat-icono-preview" class="bi bi-tag fs-5"></i>
                        </span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-icono-picker-toggle">Elegir ícono</button>
                    </div>
                    <div id="icono-picker-grid" class="d-none border rounded p-2">
                        <input type="text" id="icono-picker-search" class="form-control form-control-sm mb-2" placeholder="Buscar ícono... ej: internet, agua, casa">
                        <div class="row g-1" id="icono-picker-items" style="max-height:150px;overflow-y:auto;"></div>
                        <div id="icono-picker-empty" class="d-none text-muted small text-center py-2">Sin resultados</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-cat-save" class="btn btn-primary btn-sm">Guardar</button>
            </div>
        </div>
    </div>
</div>

{# ── Gastos Fijos ── #}
<div class="content-card mb-4" id="wallet-gastos-fijos-card">
    <div class="content-card-header">
        Gastos Fijos
        <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center gap-1" style="font-size:12px;color:#64748b;">
                <select id="gf-mes-select" class="form-select form-select-sm" style="width:auto;font-size:12px;padding:2px 8px;">
                    <option value="1">Enero</option><option value="2">Febrero</option><option value="3">Marzo</option>
                    <option value="4">Abril</option><option value="5">Mayo</option><option value="6">Junio</option>
                    <option value="7">Julio</option><option value="8">Agosto</option><option value="9">Septiembre</option>
                    <option value="10">Octubre</option><option value="11">Noviembre</option><option value="12">Diciembre</option>
                </select>
                <select id="gf-anio-select" class="form-select form-select-sm" style="width:auto;font-size:12px;padding:2px 8px;">
                    {% set anioActual = "now"|date("Y")|number_format(0, '', '') %}
                    {% for y in range(anioActual - 1, anioActual + 1) %}
                    <option value="{{ y }}">{{ y }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="button" class="btn btn-sm btn-primary" id="btn-nuevo-gasto-fijo">
                <i class="bi bi-plus-lg me-1"></i>Nuevo
            </button>
        </div>
    </div>
    <div class="content-card-body">
        {# Stats del mes #}
        <div class="row g-2 mb-3" id="gf-stats-row" style="display:none!important;">
            <div class="col-4">
                <div class="wallet-stat py-2 px-3">
                    <div class="wallet-stat-label">Total mensual</div>
                    <div class="wallet-stat-value" id="gf-stat-total" style="font-size:18px;">L 0.00</div>
                </div>
            </div>
            <div class="col-4">
                <div class="wallet-stat py-2 px-3">
                    <div class="wallet-stat-label">Pagado</div>
                    <div class="wallet-stat-value saldo-pos" id="gf-stat-pagado" style="font-size:18px;">L 0.00</div>
                </div>
            </div>
            <div class="col-4">
                <div class="wallet-stat py-2 px-3">
                    <div class="wallet-stat-label">Pendiente</div>
                    <div class="wallet-stat-value tipo-gasto" id="gf-stat-pendiente" style="font-size:18px;">L 0.00</div>
                </div>
            </div>
        </div>
        <div id="gf-lista"></div>
    </div>
</div>

{# ── Modal Gasto Fijo ── #}
<div class="modal fade grova-modal--macos" id="modal-gasto-fijo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="modal-gasto-fijo-title">Nuevo gasto fijo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="gf-mode" value="create">
                <input type="hidden" id="gf-edit-url" value="">
                <input type="hidden" id="gf-csrf" value="{{ csrf_token('wallet_gasto_fijo_create') }}">

                {# ── Selector de tipo ── #}
                <div class="mb-3">
                    <label class="form-label small mb-2">Tipo de gasto</label>
                    <div class="d-flex flex-wrap gap-2 mb-2" id="gf-tipo-btns">
                        <button type="button" class="btn btn-sm js-gf-tipo active" data-tipo="generico"
                                style="border:1px solid #334155;border-radius:8px;padding:.4rem .9rem;">
                            <i class="bi bi-tag me-1"></i>Simple
                        </button>
                        <button type="button" class="btn btn-sm js-gf-tipo" data-tipo="financiado"
                                style="border:1px solid #334155;border-radius:8px;padding:.4rem .9rem;">
                            <i class="bi bi-box-seam me-1"></i>Compra financiada
                        </button>
                        <button type="button" class="btn btn-sm js-gf-tipo" data-tipo="prestamo"
                                style="border:1px solid #334155;border-radius:8px;padding:.4rem .9rem;">
                            <i class="bi bi-bank me-1"></i>Préstamo
                        </button>
                        <button type="button" class="btn btn-sm js-gf-tipo" data-tipo="suscripcion"
                                style="border:1px solid #334155;border-radius:8px;padding:.4rem .9rem;">
                            <i class="bi bi-arrow-repeat me-1"></i>Suscripción
                        </button>
                    </div>
                    <div id="gf-tipo-desc" style="font-size:11.5px;color:#64748b;background:#0f172a22;border-left:3px solid #3b82f6;border-radius:0 6px 6px 0;padding:.45rem .75rem;line-height:1.5;"></div>
                    <input type="hidden" id="gf-tipo" value="generico">
                </div>

                {# ── Nombre ── #}
                <div class="mb-3">
                    <label class="form-label small mb-1">Nombre <span class="text-danger">*</span></label>
                    <input type="text" id="gf-nombre" class="form-control form-control-sm"
                           placeholder="Ej: Netflix, Claro iPhone, Banco Atlántida" maxlength="100">
                </div>

                {# ── Días de pago y corte ── #}
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Frecuencia</label>
                        <select id="gf-frecuencia" class="form-select form-select-sm">
                            <option value="mensual">Mensual</option>
                            <option value="quincenal">Quincenal</option>
                            <option value="semanal">Semanal</option>
                            <option value="irregular">Irregular</option>
                        </select>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label small mb-1">Día de pago</label>
                        <div class="gf-day-picker" id="gf-dia-pago-picker"></div>
                        <input type="hidden" id="gf-dia-pago" value="1">
                    </div>
                    <div class="col-12 col-sm-6 js-gf-corte-col">
                        <label class="form-label small mb-1">Día de corte <small class="text-muted">(opcional)</small></label>
                        <div class="gf-day-picker" id="gf-dia-corte-picker"></div>
                        <input type="hidden" id="gf-dia-corte" value="">
                    </div>
                </div>

                {# ── Bloque: Financiamiento (financiado | prestamo) ── #}
                <div id="gf-bloque-financiamiento" style="display:none;">
                    <hr class="my-2">
                    <div class="small fw-semibold text-muted mb-2" id="gf-financiamiento-label">Datos del financiamiento</div>
                    <div class="row g-2 mb-2">
                        <div class="col-sm-4">
                            <label class="form-label small mb-1">Fecha de inicio</label>
                            <input type="date" id="gf-fecha-inicio-plan" class="form-control form-control-sm">
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small mb-1">Total de cuotas / meses</label>
                            <input type="number" id="gf-meses-financiamiento" class="form-control form-control-sm" min="1" placeholder="18">
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small mb-1">Prima / enganche (L)</label>
                            <input type="number" id="gf-monto-prima" class="form-control form-control-sm" min="0" step="0.01" placeholder="0.00">
                        </div>
                    </div>

                    {# Tramos de cuotas #}
                    <div class="mb-2">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="form-label small mb-0">Tramos de cuota <small class="text-muted">(si el monto varía)</small></label>
                            <button type="button" class="btn btn-xs btn-outline-secondary" id="btn-gf-add-tramo" style="font-size:11px;padding:1px 8px;">
                                <i class="bi bi-plus-lg"></i> Tramo
                            </button>
                        </div>
                        <div id="gf-tramos-lista">
                            {# Se generan dinámicamente #}
                        </div>
                        <input type="hidden" id="gf-cuotas-especiales" value="">
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label small mb-1">Monto mensual base (L) <span class="text-danger">*</span></label>
                            <input type="number" id="gf-monto" class="form-control form-control-sm" min="0.01" step="0.01" placeholder="0.00">
                            <div class="form-text" id="gf-monto-hint-fin">Si usás tramos, ponés el monto de la última cuota (o el que aplica si no hay tramo).</div>
                        </div>
                        <div class="col-sm-6" id="gf-post-fin-wrap">
                            <label class="form-label small mb-1">Monto tras terminar el financiamiento (L)</label>
                            <input type="number" id="gf-monto-post-financiamiento" class="form-control form-control-sm" min="0" step="0.01" placeholder="Ej: 1600">
                            <div class="form-text">Ej: solo el plan de internet que queda. Vacío = gasto termina.</div>
                        </div>
                    </div>
                    <hr class="my-2">
                </div>

                {# ── Bloque: Monto simple (generico | suscripcion) ── #}
                <div id="gf-bloque-monto-simple">
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label small mb-1">Monto (L) <span class="text-danger">*</span></label>
                            <input type="number" id="gf-monto-simple" class="form-control form-control-sm" min="0.01" step="0.01" placeholder="0.00">
                        </div>
                        <div class="col-sm-6 d-flex align-items-end pb-1">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="gf-check-unidades" role="switch">
                                <label class="form-check-label small" for="gf-check-unidades">Manejo por unidades</label>
                            </div>
                        </div>
                    </div>
                    <div id="gf-bloque-unidades" style="display:none;">
                        <div class="row g-2 mb-2">
                            <div class="col-sm-4">
                                <label class="form-label small mb-1">Unidad</label>
                                <select id="gf-unidad-sel" class="form-select form-select-sm">
                                    <option value="">— elige —</option>
                                    <option value="botellón">botellón</option>
                                    <option value="galón">galón</option>
                                    <option value="litro">litro</option>
                                    <option value="libra">libra</option>
                                    <option value="kilo">kilo</option>
                                    <option value="gramo">gramo</option>
                                    <option value="unidad">unidad</option>
                                    <option value="caja">caja</option>
                                    <option value="bolsa">bolsa</option>
                                    <option value="paquete">paquete</option>
                                    <option value="botella">botella</option>
                                    <option value="lata">lata</option>
                                    <option value="servicio">servicio</option>
                                    <option value="mes">mes</option>
                                    <option value="__otro__">Otra unidad…</option>
                                </select>
                                <input type="text" id="gf-unidad-custom" class="form-control form-control-sm mt-1"
                                       placeholder="escribe la unidad" maxlength="50" style="display:none;">
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label small mb-1">Presentación</label>
                                <select id="gf-presentacion-sel" class="form-select form-select-sm">
                                    <option value="">— elige —</option>
                                    <option value="20L">20L</option>
                                    <option value="5 galones">5 galones</option>
                                    <option value="1 galón">1 galón</option>
                                    <option value="500ml">500ml</option>
                                    <option value="1L">1L</option>
                                    <option value="2L">2L</option>
                                    <option value="25 lbs">25 lbs</option>
                                    <option value="50 lbs">50 lbs</option>
                                    <option value="1 kg">1 kg</option>
                                    <option value="500g">500g</option>
                                    <option value="6 unidades">6 unidades</option>
                                    <option value="12 unidades">12 unidades</option>
                                    <option value="24 unidades">24 unidades</option>
                                    <option value="__otro__">Otra…</option>
                                </select>
                                <input type="text" id="gf-presentacion-custom" class="form-control form-control-sm mt-1"
                                       placeholder="ej: 18 kg, 750ml…" maxlength="50" style="display:none;">
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label small mb-1">Cant. base <small class="text-muted">/ período</small></label>
                                <input type="number" id="gf-cantidad-base" class="form-control form-control-sm" min="0.01" step="0.01" placeholder="7">
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-sm-5">
                                <label class="form-label small mb-1">Precio por unidad (L)</label>
                                <input type="number" id="gf-precio-unitario" class="form-control form-control-sm" min="0.01" step="0.01" placeholder="57.00">
                            </div>
                            <div class="col-sm-7 d-flex align-items-end pb-1">
                                <small class="text-muted">Cantidad × precio = presupuesto.</small>
                            </div>
                        </div>
                    </div>
                </div>

                {# ── Cuenta y categoría (siempre visible) ── #}
                <div class="mb-2">
                    <label class="form-label small mb-1">Cuenta (opcional)</label>
                    <select id="gf-cuenta-id" class="form-select form-select-sm">
                        <option value="">— Cartera general —</option>
                        {% for cuenta in cuentas %}
                        <option value="{{ cuenta.id }}">{{ cuenta.nombre }}{% if cuenta.institucion %} · {{ cuenta.institucion }}{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Categoría (opcional)</label>
                    <div class="input-group input-group-sm">
                        <select id="gf-category-id" class="form-select form-select-sm">
                            <option value="">— Sin categoría —</option>
                            {% for cat in categories %}
                            <option value="{{ cat.id }}">{{ cat.nombre }}</option>
                            {% endfor %}
                        </select>
                        <button type="button" class="btn btn-outline-secondary js-quick-add-cat" data-target="gf-category-id" title="Nueva categoría"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Nota (opcional)</label>
                    <input type="text" id="gf-nota" class="form-control form-control-sm" placeholder="Ej: trabajo me reembolsa el plan" maxlength="255">
                </div>

                {# ── Acceso / Pago ── #}
                <div class="mt-2">
                    <button type="button" class="btn btn-link btn-sm p-0 text-secondary js-gf-toggle-acceso" style="font-size:12px;text-decoration:none;">
                        <i class="bi bi-chevron-right js-gf-acceso-chevron" style="font-size:10px;transition:transform .2s;"></i>
                        Datos de acceso y pago <small class="text-muted">(opcional)</small>
                    </button>
                    <div id="gf-bloque-acceso" style="display:none;" class="mt-2">
                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <label class="form-label small mb-1"><i class="bi bi-link-45deg me-1"></i>Link de pago</label>
                                <input type="url" id="gf-url-pago" class="form-control form-control-sm"
                                       placeholder="https://pagos.claro.com.hn/…" maxlength="500">
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <label class="form-label small mb-1"><i class="bi bi-person me-1"></i>N.º cliente / cuenta</label>
                                <input type="text" id="gf-numero-cliente" class="form-control form-control-sm"
                                       placeholder="Ej: 504-1234567" maxlength="100">
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small mb-1"><i class="bi bi-at me-1"></i>Usuario / correo</label>
                                <input type="text" id="gf-usuario-acceso" class="form-control form-control-sm"
                                       placeholder="usuario@correo.com" maxlength="150">
                            </div>
                            <div class="col-12">
                                <label class="form-label small mb-1"><i class="bi bi-key me-1"></i>Contraseña <small class="text-muted">(cifrada)</small></label>
                                <div class="input-group input-group-sm">
                                    <input type="password" id="gf-clave-acceso" class="form-control form-control-sm"
                                           placeholder="••••••••" maxlength="200" autocomplete="new-password">
                                    <button type="button" class="btn btn-outline-secondary js-gf-toggle-clave" tabindex="-1">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="form-text" style="font-size:10px;">Se guarda cifrada. Dejá en blanco para no cambiarla al editar.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-check mt-2 js-gf-activo-row" style="display:none;">
                    <input class="form-check-input" type="checkbox" id="gf-activo" checked>
                    <label class="form-check-label small" for="gf-activo">Activo</label>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-gf-save" class="btn btn-primary btn-sm">Guardar</button>
            </div>
        </div>
    </div>
</div>

{# ── Movimientos (DataTable AJAX) ── #}
<div class="content-card">
    <div class="content-card-header">
        Movimientos
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-nueva-transferencia">
                <i class="bi bi-arrow-left-right me-1"></i>Transferir
            </button>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modal-nuevo-movimiento">
                <i class="bi bi-plus-lg me-1"></i>Nuevo
            </button>
        </div>
    </div>
    <div class="content-card-body p-0">
        <div class="table-responsive">
            <table id="wallet-entries-table" class="table table-hover mb-0" style="color:inherit;">
                <thead>
                    <tr>
                        <th style="width:100px;">Fecha</th>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th>Cuenta</th>
                        <th style="width:70px;">Tipo</th>
                        <th style="width:130px;text-align:right;">Monto</th>
                        <th style="width:50px;"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

{# ── Modal nueva/editar cuenta ── #}
<div class="modal fade grova-modal--macos" id="modal-wallet-cuenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="modal-wallet-cuenta-title">Nueva cuenta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="wallet-cuenta-mode" value="create">
                <input type="hidden" id="wallet-cuenta-edit-url" value="">
                <input type="hidden" id="wallet-cuenta-csrf" value="">
                <div class="mb-3">
                    <label class="form-label small mb-1">Nombre <span class="text-danger">*</span></label>
                    <input type="text" id="wallet-cuenta-nombre" class="form-control form-control-sm" placeholder="Ej: BAC Visa Crédito" maxlength="100">
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Institución / Banco</label>
                        <div class="input-group input-group-sm">
                            <select id="wallet-cuenta-institucion-id" class="form-select form-select-sm">
                                <option value="">— Sin institución —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary" id="btn-nueva-inst-inline" title="Nueva institución">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Número de cuenta <small class="text-muted">(encriptado)</small></label>
                        <input type="text" id="wallet-cuenta-numero-cuenta" class="form-control form-control-sm" placeholder="0011234567890" maxlength="30" inputmode="numeric">
                    </div>
                </div>
                <div class="row g-2 mb-3" id="wallet-cuenta-tarjeta-row">
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Número de tarjeta <small class="text-muted">(encriptado)</small></label>
                        <input type="text" id="wallet-cuenta-tarjeta-digitos" class="form-control form-control-sm" placeholder="4111 1234 5678 9010" maxlength="19" inputmode="numeric">
                    </div>
                    <div class="col-sm-6 d-flex align-items-end pb-1">
                        <small class="text-muted">Solo si tiene tarjeta de débito asociada.</small>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Tipo <span class="text-danger">*</span></label>
                        <select id="wallet-cuenta-tipo" class="form-select form-select-sm">
                            <option value="debito">Débito</option>
                            <option value="credito">Crédito</option>
                            <option value="ahorro">Ahorro</option>
                            <option value="ahorro_retirable">Ahorro retirable</option>
                            <option value="aportaciones">Aportaciones</option>
                            <option value="efectivo">Efectivo</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Saldo inicial (L)</label>
                        <input type="number" id="wallet-cuenta-saldo-inicial" class="form-control form-control-sm" value="0" min="0" step="0.01">
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Color</label>
                    <input type="color" id="wallet-cuenta-color" class="form-control form-control-color form-control-sm" value="#64748b">
                </div>
                <div class="form-check mt-2 js-wallet-cuenta-activo-row" style="display:none;">
                    <input class="form-check-input" type="checkbox" id="wallet-cuenta-activo" checked>
                    <label class="form-check-label small" for="wallet-cuenta-activo">Cuenta activa</label>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-wallet-cuenta-save" class="btn btn-primary btn-sm">Guardar</button>
            </div>
        </div>
    </div>
</div>

{# ── Modal nuevo movimiento ── #}
<div class="modal fade grova-modal--macos" id="modal-nuevo-movimiento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title">Nuevo movimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="wallet-entry-csrf" value="{{ csrf_token('wallet_entry') }}">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small mb-1">Tipo</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="wallet-tipo" id="wallet-tipo-gasto" value="gasto" checked>
                                <label class="form-check-label text-danger" for="wallet-tipo-gasto">Gasto</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="wallet-tipo" id="wallet-tipo-ingreso" value="ingreso">
                                <label class="form-check-label text-success" for="wallet-tipo-ingreso">Ingreso</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1" for="wallet-monto">Monto (L) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-sm" id="wallet-monto" min="0.01" step="0.01" placeholder="0.00">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1" for="wallet-fecha">Fecha <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm" id="wallet-fecha" value="{{ 'now'|date('Y-m-d') }}">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1" for="wallet-category">Categoría</label>
                        <div class="input-group input-group-sm">
                        <select class="form-select form-select-sm" id="wallet-category"
                                data-placeholder="Sin categoría" data-allow-clear="true"
                                data-dropdown-parent="#modal-nuevo-movimiento">
                            <option value=""></option>
                            {% set gastos_cat   = categories|filter(c => c.tipo == 'gasto') %}
                            {% set ingresos_cat = categories|filter(c => c.tipo == 'ingreso') %}
                            {% if ingresos_cat|length %}
                            <optgroup label="Ingresos">{% for cat in ingresos_cat %}<option value="{{ cat.id }}">{{ cat.nombre }}</option>{% endfor %}</optgroup>
                            {% endif %}
                            {% if gastos_cat|length %}
                            <optgroup label="Gastos">{% for cat in gastos_cat %}<option value="{{ cat.id }}">{{ cat.nombre }}</option>{% endfor %}</optgroup>
                            {% endif %}
                        </select>
                        <button type="button" class="btn btn-outline-secondary js-quick-add-cat" data-target="wallet-category" title="Nueva categoría"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1" for="wallet-cuenta-sel">Cuenta</label>
                        <select class="form-select form-select-sm grova-select2" id="wallet-cuenta-sel"
                                data-placeholder="Cartera general" data-allow-clear="true"
                                data-dropdown-parent="#modal-nuevo-movimiento">
                            <option value=""></option>
                            {% for cuenta in cuentas %}
                            <option value="{{ cuenta.id }}">{{ cuenta.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1" for="wallet-desc">Descripción</label>
                        <input type="text" class="form-control form-control-sm" id="wallet-desc" placeholder="Opcional" maxlength="255">
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-wallet-entry-save" class="btn btn-primary btn-sm">Guardar</button>
            </div>
        </div>
    </div>
</div>

{# ── Historial de transferencias ── #}
<div class="content-card mt-4">
    <div class="content-card-header">
        <span><i class="bi bi-arrow-left-right me-1"></i>Transferencias entre cuentas</span>
    </div>
    <div class="content-card-body p-0">
        <div id="wallet-transferencias-lista"></div>
    </div>
</div>

{# ── Modal Transferencia ── #}
<div class="modal fade grova-modal--macos" id="modal-transferencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title"><i class="bi bi-arrow-left-right me-2"></i>Transferencia entre cuentas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="tf-csrf" value="{{ csrf_token('wallet_transferencia_create') }}">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Fecha <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm" id="tf-fecha" value="{{ 'now'|date('Y-m-d') }}">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Monto (L) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-sm" id="tf-monto" min="0.01" step="0.01" placeholder="0.00">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Desde <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="tf-origen">
                            <option value="">— Cartera general —</option>
                            {% for cuenta in cuentas %}
                            <option value="{{ cuenta.id }}">{{ cuenta.nombre }}{% if cuenta.numeroCuenta %} · {{ cuenta.numeroCuenta|decrypt }}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Hacia <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" id="tf-destino">
                            <option value="">— Cartera general —</option>
                            {% for cuenta in cuentas %}
                            <option value="{{ cuenta.id }}">{{ cuenta.nombre }}{% if cuenta.numeroCuenta %} · {{ cuenta.numeroCuenta|decrypt }}{% endif %}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Comisión (L) <small class="text-muted">opcional</small></label>
                        <input type="number" class="form-control form-control-sm" id="tf-comision" min="0" step="0.01" placeholder="0.00" value="0">
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small mb-1">Concepto <small class="text-muted">opcional</small></label>
                        <input type="text" class="form-control form-control-sm" id="tf-concepto" placeholder="Ej: pago tarjeta" maxlength="255">
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-tf-save" class="btn btn-primary btn-sm">
                    <i class="bi bi-arrow-left-right me-1"></i>Transferir
                </button>
            </div>
        </div>
    </div>
</div>

{# ── Modal Institución ── #}
<div class="modal fade grova-modal--macos" id="modal-institucion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="modal-inst-title"><i class="bi bi-bank me-2"></i>Nueva institución</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="inst-mode" value="create">
                <input type="hidden" id="inst-edit-id" value="">
                <input type="hidden" id="inst-csrf" value="{{ csrf_token('wallet_institucion_create') }}">
                <input type="hidden" id="inst-delete-token" value="">
                <div class="mb-3">
                    <label class="form-label small mb-1">Nombre <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" id="inst-nombre" placeholder="Ej: Banco Atlántida" maxlength="100">
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">Color de marca</label>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="color" class="form-control form-control-color form-control-sm" id="inst-color" value="#64748b" style="width:48px;height:32px;padding:2px;">
                        <span class="small text-muted">Color representativo del banco</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 justify-content-between">
                <button type="button" id="btn-inst-delete" class="btn btn-sm btn-link text-danger p-0" style="display:none;">
                    <i class="bi bi-trash3 me-1"></i>Eliminar
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btn-inst-save" class="btn btn-primary btn-sm">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block app_page_scripts %}
<script>
(function () {
    var ENTRIES_URL       = {{ path('grova_wallet_entries_data', {_locale: app.request.locale})|json_encode|raw }};
    var CUENTAS_DATA_URL  = {{ path('grova_wallet_cuenta_data', {_locale: app.request.locale})|json_encode|raw }};
    var CREATE_CUENTA_URL = {{ path('grova_wallet_cuenta_create', {_locale: app.request.locale})|json_encode|raw }};
