        bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-gasto-fijo')).show();
    });

    // ── Abrir modal (editar) ─────────────────────────────────────────────────
    function bindGfEdit() {
        document.querySelectorAll('.js-gf-edit').forEach(function(btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = '1';
            btn.addEventListener('click', function() {
                var tipo = btn.dataset.tipo || 'generico';
                var id   = btn.dataset.id;

                document.getElementById('gf-mode').value = 'edit';
                document.getElementById('modal-gasto-fijo-title').textContent = 'Editar gasto fijo';
                document.getElementById('gf-nombre').value    = btn.dataset.nombre;
                document.getElementById('gf-frecuencia').value = btn.dataset.frecuencia || 'mensual';
                setDiaPago(btn.dataset.diaPago || 1);
                setDiaCorte(btn.dataset.diaCorte || '');

                var esFinanciado = tipo === 'financiado' || tipo === 'prestamo';
                if (esFinanciado) {
                    document.getElementById('gf-monto').value                    = btn.dataset.montoBase;
                    document.getElementById('gf-fecha-inicio-plan').value        = btn.dataset.fechaInicioPlan || '';
                    document.getElementById('gf-meses-financiamiento').value     = btn.dataset.mesesFinanciamiento || '';
                    document.getElementById('gf-monto-prima').value              = btn.dataset.montoPrima || '';
                    document.getElementById('gf-monto-post-financiamiento').value = btn.dataset.montoPostFinanciamiento || '';
                    try { gfTramos = JSON.parse(btn.dataset.cuotasEspeciales) || []; } catch(e) { gfTramos = []; }
                } else {
                    document.getElementById('gf-monto-simple').value = btn.dataset.montoBase;
                    var tieneUnidad = !!(btn.dataset.unidad);
                    document.getElementById('gf-check-unidades').checked    = tieneUnidad;
                    setGfUnidad(btn.dataset.unidad || '');
                    setGfPresentacion(btn.dataset.presentacion || '');
                    document.getElementById('gf-cantidad-base').value       = btn.dataset.cantidadBase || '';
                    document.getElementById('gf-precio-unitario').value     = btn.dataset.precioUnitario || '';
                    gfTramos = [];
                }

                renderTramos();
                document.getElementById('gf-cuenta-id').value   = btn.dataset.cuentaId || '';
                document.getElementById('gf-category-id').value = btn.dataset.categoryId || '';
                document.getElementById('gf-nota').value        = btn.dataset.nota || '';
                restoreGfAcceso(btn);
                document.getElementById('gf-activo').checked    = btn.dataset.activo === '1';
                document.querySelector('.js-gf-activo-row').style.display = '';

                gfSetTipo(tipo);
                gfToggleUnidades();

                var editUrl = {{ path('grova_wallet_gasto_fijo_edit', {id: '__ID__', _locale: app.request.locale})|json_encode|raw }}.replace('__ID__', id);
                document.getElementById('gf-edit-url').value = editUrl;
                document.getElementById('gf-csrf').value     = btn.dataset.tokenEdit;

                bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-gasto-fijo')).show();
            });
        });
    }

    // ── Guardar ──────────────────────────────────────────────────────────────
    document.getElementById('btn-gf-save').addEventListener('click', async function() {
        var nombre = document.getElementById('gf-nombre').value.trim();
        var tipo   = document.getElementById('gf-tipo').value;
        var esFinanciado = tipo === 'financiado' || tipo === 'prestamo';

        var monto = esFinanciado
            ? parseFloat(document.getElementById('gf-monto').value)
            : parseFloat(document.getElementById('gf-monto-simple').value);

        if (!nombre || isNaN(monto) || monto <= 0) {
            toast('error', 'Nombre y monto son obligatorios.');
            return;
        }

        var mode    = document.getElementById('gf-mode').value;
        var url     = mode === 'edit' ? document.getElementById('gf-edit-url').value : GF_CREATE_URL;
        var diaPago = parseInt(document.getElementById('gf-dia-pago').value) || 1;

        var fd = new FormData();
        fd.append('_token',    document.getElementById('gf-csrf').value);
        fd.append('nombre',    nombre);
        fd.append('monto',     monto);
        fd.append('tipo',      tipo);
        fd.append('frecuencia', document.getElementById('gf-frecuencia').value);
        fd.append('dia_pago',  diaPago);
        fd.append('dia_corte', document.getElementById('gf-dia-corte').value);

        if (esFinanciado) {
            fd.append('fecha_inicio_plan',         document.getElementById('gf-fecha-inicio-plan').value);
            fd.append('meses_financiamiento',      document.getElementById('gf-meses-financiamiento').value);
            fd.append('monto_prima',               document.getElementById('gf-monto-prima').value);
            fd.append('cuotas_especiales',         document.getElementById('gf-cuotas-especiales').value);
            fd.append('monto_post_financiamiento', document.getElementById('gf-monto-post-financiamiento').value);
        } else {
            var usaUnidades = document.getElementById('gf-check-unidades').checked;
            fd.append('unidad',          usaUnidades ? getGfUnidad() : '');
            fd.append('presentacion',    usaUnidades ? getGfPresentacion() : '');
            fd.append('cantidad_base',   usaUnidades ? document.getElementById('gf-cantidad-base').value : '');
            fd.append('precio_unitario', usaUnidades ? document.getElementById('gf-precio-unitario').value : '');
        }

        fd.append('cuenta_id',   document.getElementById('gf-cuenta-id').value);
        fd.append('category_id', document.getElementById('gf-category-id').value);
        fd.append('nota',            document.getElementById('gf-nota').value.trim());
        fd.append('url_pago',        document.getElementById('gf-url-pago').value.trim());
        fd.append('numero_cliente',  document.getElementById('gf-numero-cliente').value.trim());
        fd.append('usuario_acceso',  document.getElementById('gf-usuario-acceso').value.trim());
        fd.append('clave_acceso',    document.getElementById('gf-clave-acceso').value);
        if (mode === 'edit') fd.append('activo', document.getElementById('gf-activo').checked ? '1' : '0');

        var r    = await fetch(url, { method:'POST', body:fd, credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'} });
        var json = await r.json();
        if (json.success) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('modal-gasto-fijo')).hide();
            toast('success', json.message);
            loadGastosFijos();
        } else {
            toast('error', json.message);
        }
    });

    // ── Pagar ────────────────────────────────────────────────────────────────
    function bindGfPagar() {
        document.querySelectorAll('.js-gf-pagar').forEach(function(btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = '1';
            btn.addEventListener('click', async function() {
                var id           = btn.dataset.id;
                var nombre       = btn.dataset.nombre;
                var monto        = btn.dataset.monto;
                var tieneUnidades = btn.dataset.unidad && btn.dataset.unidad !== '';
                var unidad       = btn.dataset.unidad || '';
                var precioBase   = parseFloat(btn.dataset.precioUnitario || '0');
                var cantidadBase = parseFloat(btn.dataset.cantidadBase || '0');
                var hoy          = new Date().toISOString().split('T')[0];

                var htmlPago = '<p class="mb-2 small fw-semibold">' + nombre + '</p><div class="row g-2">'
                    + '<div class="col-6"><label class="form-label small mb-1">Fecha</label>'
                    + '<input id="swal-gf-fecha" type="date" class="form-control form-control-sm" value="' + hoy + '"></div>';

                if (tieneUnidades) {
                    htmlPago += '<div class="col-3"><label class="form-label small mb-1">Cantidad (' + unidad + ')</label>'
                        + '<input id="swal-gf-cantidad" type="number" class="form-control form-control-sm" value="' + (cantidadBase || '') + '" min="0.01" step="0.01"></div>'
                        + '<div class="col-3"><label class="form-label small mb-1">Precio/u (L)</label>'
                        + '<input id="swal-gf-precio-unit" type="number" class="form-control form-control-sm" value="' + (precioBase || '') + '" min="0.01" step="0.01"></div>'
                        + '</div><div class="row g-2 mt-1">'
                        + '<div class="col-6"><label class="form-label small mb-1">Total (L)</label>'
                        + '<input id="swal-gf-monto" type="number" class="form-control form-control-sm" value="' + parseFloat(monto).toFixed(2) + '" min="0.01" step="0.01"></div>';
                } else {
                    htmlPago += '<div class="col-6"><label class="form-label small mb-1">Monto (L)</label>'
                        + '<input id="swal-gf-monto" type="number" class="form-control form-control-sm" value="' + parseFloat(monto).toFixed(2) + '" min="0.01" step="0.01"></div>'
                        + '</div><div class="row g-2 mt-1">';
                }

                htmlPago += '<div class="col-6"><div class="form-check mt-1"><input class="form-check-input" type="checkbox" id="swal-gf-extra">'
                    + '<label class="form-check-label small" for="swal-gf-extra">Pago extra</label></div></div></div>'
                    + '<div class="form-check mt-2"><input class="form-check-input" type="checkbox" id="swal-gf-actualizar">'
                    + '<label class="form-check-label small" for="swal-gf-actualizar">Actualizar precio base</label></div>';

                var res = await window.Swal.fire({
                    title: 'Registrar pago',
                    html: htmlPago,
                    showCancelButton: true,
                    confirmButtonText: 'Registrar', cancelButtonText: 'Cancelar', confirmButtonColor: '#22c55e',
                    didOpen: function() {
                        if (tieneUnidades) {
                            var inpCant = document.getElementById('swal-gf-cantidad');
                            var inpPrice = document.getElementById('swal-gf-precio-unit');
                            var inpTotal = document.getElementById('swal-gf-monto');
                            function recalc() {
                                var c = parseFloat(inpCant.value), p = parseFloat(inpPrice.value);
                                if (c > 0 && p > 0) inpTotal.value = (c * p).toFixed(2);
                            }
                            inpCant.addEventListener('input', recalc);
                            inpPrice.addEventListener('input', recalc);
                        }
                    },
                    preConfirm: function() {
                        var v = parseFloat(document.getElementById('swal-gf-monto').value);
                        if (isNaN(v) || v <= 0) { window.Swal.showValidationMessage('El monto debe ser mayor a 0.'); return false; }
                        return {
                            monto: v,
                            fecha: document.getElementById('swal-gf-fecha').value,
                            cantidad: tieneUnidades ? document.getElementById('swal-gf-cantidad').value : '',
                            precioUnit: tieneUnidades ? document.getElementById('swal-gf-precio-unit').value : '',
                            esExtra: document.getElementById('swal-gf-extra').checked,
                            actualizar: document.getElementById('swal-gf-actualizar').checked,
                        };
                    }
                });
                if (!res.isConfirmed) return;

                var fd = new FormData();
                fd.append('_token',          btn.dataset.token);
                fd.append('fecha',           res.value.fecha);
                fd.append('monto',           res.value.monto);
                fd.append('cantidad',        res.value.cantidad);
                fd.append('precio_unitario', res.value.precioUnit);
                fd.append('es_extra',        res.value.esExtra ? '1' : '0');
                fd.append('actualizar_monto', res.value.actualizar ? '1' : '0');

                var url = {{ path('grova_wallet_gasto_fijo_pagar', {id: '__ID__', _locale: app.request.locale})|json_encode|raw }}.replace('__ID__', id);
                var r   = await fetch(url, { method:'POST', body:fd, credentials:'same-origin', headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'} });
                var json = await r.json();
                if (json.success) { toast('success', json.message); loadGastosFijos(); }
                else { toast('error', json.message); }
            });
        });
    }

    // ── Revertir ─────────────────────────────────────────────────────────────
