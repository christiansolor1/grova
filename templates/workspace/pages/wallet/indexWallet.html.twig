    var GF_DATA_URL     = {{ path('grova_wallet_gasto_fijo_data', {_locale: app.request.locale})|json_encode|raw }};
    var GF_CREATE_URL   = {{ path('grova_wallet_gasto_fijo_create', {_locale: app.request.locale})|json_encode|raw }};
    var GF_CREATE_TOKEN = {{ csrf_token('wallet_gasto_fijo_create')|json_encode|raw }};
    var GF_DETALLE_TPL  = GF_DATA_URL.replace('/gastos-fijos/data', '/gastos-fijos/__ID__');

    var gfAnio = new Date().getFullYear();
    var gfMes  = new Date().getMonth() + 1;

    function fmtL(n) { return 'L ' + parseFloat(n).toLocaleString('es-HN', {minimumFractionDigits:2, maximumFractionDigits:2}); }

    function estadoBadge(estado) {
        if (estado === 'pagado')    return '<span class="badge bg-success bg-opacity-20 text-success" style="font-size:10px;">PAGADO</span>';
        if (estado === 'vencido')   return '<span class="badge bg-danger bg-opacity-20 text-danger" style="font-size:10px;">VENCIDO</span>';
        if (estado === 'en_riesgo') return '<span class="badge bg-warning bg-opacity-20 text-warning" style="font-size:10px;">EN RIESGO</span>';
        return '<span class="badge" style="font-size:10px;background:#1e293b;color:#94a3b8;">PENDIENTE</span>';
    }

    function renderGastosFijos(data) {
        var gastos   = data.gastos || [];
        var lista    = document.getElementById('gf-lista');
        var statsRow = document.getElementById('gf-stats-row');

        if (gastos.length === 0) {
            lista.innerHTML = '<div class="grova-empty-state py-4"><div class="grova-empty-icon"><i class="bi bi-calendar-check"></i></div><div class="grova-empty-title">Sin gastos fijos</div><div class="grova-empty-desc">Agregá tus gastos recurrentes: luz, agua, suscripciones, créditos, etc.</div></div>';
            statsRow.style.setProperty('display', 'none', 'important');
            return;
        }

        statsRow.style.removeProperty('display');
        document.getElementById('gf-stat-total').textContent     = fmtL(data.totalMes);
        document.getElementById('gf-stat-pagado').textContent    = fmtL(data.totalPagado);
        document.getElementById('gf-stat-pendiente').textContent = fmtL(data.totalPendiente);

        var html = '<div class="table-responsive"><table class="table table-hover mb-0" style="color:inherit;font-size:13px;"><thead><tr>'
            + '<th>Nombre</th><th style="width:80px;">Pago</th><th style="width:120px;">Monto</th>'
            + '<th style="width:110px;">Cuenta</th><th style="width:90px;">Estado</th><th style="width:100px;"></th>'
            + '</tr></thead><tbody>';

        gastos.forEach(function(g) {
            // Subinfo para financiados/préstamos
            var subInfo = '';
            if ((g.tipo === 'financiado' || g.tipo === 'prestamo') && g.cuotaActual) {
                var restLabel = g.mesesRestantes !== null ? g.mesesRestantes + ' mes' + (g.mesesRestantes !== 1 ? 'es' : '') + ' restante' + (g.mesesRestantes !== 1 ? 's' : '') : '';
                subInfo = '<br><span style="font-size:10px;color:#64748b;">Cuota ' + g.cuotaActual + '/' + (g.mesesFinanciamiento || '?')
                    + (restLabel ? ' · ' + restLabel : '')
                    + (g.fechaFinPlan ? ' · termina ' + g.fechaFinPlan : '') + '</span>';
            }
            if (g.tipo === 'suscripcion') {
                subInfo = '<br><span style="font-size:10px;color:#64748b;"><i class="bi bi-arrow-repeat"></i> Suscripción</span>';
            }

            var diaInfo = g.diaPago;
            if (g.diaCorte) { diaInfo += '<br><small class="text-muted" title="Día de corte">✂ ' + g.diaCorte + '</small>'; }

            var pagos   = g.pagos || [];
            var opsPagar = '';
            if (g.activo) {
                if (g.estado !== 'pagado') {
                    opsPagar = '<button class="btn btn-success btn-sm js-gf-pagar" style="font-size:11px;padding:2px 8px;"'
                        + ' data-id="' + g.id + '" data-nombre="' + g.nombre.replace(/"/g,'&quot;') + '" data-monto="' + g.monto + '"'
                        + ' data-unidad="' + (g.unidad || '') + '" data-precio-unitario="' + (g.precioUnitario || '') + '"'
                        + ' data-cantidad-base="' + (g.cantidadBase || '') + '"'
                        + ' data-token="' + g.tokenPagar + '">'
                        + '<i class="bi bi-check-lg"></i> Pagar</button>';
                } else if (pagos.length > 0) {
                    opsPagar = '<button class="btn btn-outline-secondary btn-sm js-gf-revertir" style="font-size:11px;padding:2px 8px;"'
                        + ' data-pago-id="' + pagos[0].id + '" data-nombre="' + g.nombre.replace(/"/g,'&quot;') + '"'
                        + ' data-token="' + pagos[0].tokenRevertir + '">'
                        + '<i class="bi bi-arrow-counterclockwise"></i></button>';
                }
            }

            var verBtn = '<a class="btn btn-link btn-sm p-0 text-secondary ms-1"'
                + ' href="' + GF_DETALLE_TPL.replace('__ID__', g.id) + '"'
                + ' title="Ver detalle"><i class="bi bi-eye" style="font-size:11px;"></i></a>';

            var editBtn = '<button class="btn btn-link btn-sm p-0 text-secondary js-gf-edit ms-1"'
                + ' data-id="' + g.id + '"'
                + ' data-nombre="' + g.nombre.replace(/"/g,'&quot;') + '"'
                + ' data-tipo="' + (g.tipo || 'generico') + '"'
                + ' data-monto-base="' + g.montoBase + '"'
                + ' data-dia-pago="' + g.diaPago + '"'
                + ' data-dia-corte="' + (g.diaCorte || '') + '"'
                + ' data-frecuencia="' + (g.frecuencia || 'mensual') + '"'
                + ' data-unidad="' + (g.unidad || '') + '"'
                + ' data-presentacion="' + (g.presentacion || '') + '"'
                + ' data-cantidad-base="' + (g.cantidadBase || '') + '"'
                + ' data-precio-unitario="' + (g.precioUnitario || '') + '"'
                + ' data-fecha-inicio-plan="' + (g.fechaInicioPlan || '') + '"'
                + ' data-meses-financiamiento="' + (g.mesesFinanciamiento || '') + '"'
                + ' data-monto-prima="' + (g.montoPrima || '') + '"'
                + ' data-cuotas-especiales=\'' + JSON.stringify(g.cuotasEspeciales || []) + '\''
                + ' data-monto-post-financiamiento="' + (g.montoPostFinanciamiento || '') + '"'
                + ' data-cuenta-id="' + (g.cuentaId || '') + '"'
                + ' data-category-id="' + (g.categoryId || '') + '"'
                + ' data-nota="' + (g.nota || '').replace(/"/g,'&quot;') + '"'
                + ' data-activo="' + (g.activo ? '1' : '0') + '"'
                + ' data-url-pago="' + (g.urlPago || '').replace(/"/g,'&quot;') + '"'
                + ' data-numero-cliente="' + (g.numeroCliente || '').replace(/"/g,'&quot;') + '"'
                + ' data-usuario-acceso="' + (g.usuarioAcceso || '').replace(/"/g,'&quot;') + '"'
                + ' data-clave-acceso="' + (g.claveAcceso || '').replace(/"/g,'&quot;') + '"'
                + ' data-token-edit="' + g.tokenEdit + '"'
                + ' title="Editar"><i class="bi bi-pencil" style="font-size:11px;"></i></button>';

            var linkPago = g.urlPago
                ? ' <a href="' + g.urlPago + '" target="_blank" rel="noopener" title="Ir a pagar" style="font-size:11px;color:#3b82f6;">'
                  + '<i class="bi bi-box-arrow-up-right"></i></a>'
                : '';

            html += '<tr' + (!g.activo ? ' style="opacity:.5;"' : '') + '>'
                + '<td><span style="font-weight:600;">' + g.nombre + '</span>' + linkPago + subInfo + (g.nota ? '<br><small class="text-muted">' + g.nota + '</small>' : '') + '</td>'
                + '<td>' + diaInfo + '</td>'
                + '<td class="tipo-gasto fw-semibold">' + g.montoFmt + '</td>'
                + '<td style="font-size:11px;color:#64748b;">' + (g.cuenta || '—') + '</td>'
                + '<td>' + estadoBadge(g.estado) + '</td>'
                + '<td class="text-end">' + opsPagar + verBtn + editBtn + '</td>'
                + '</tr>';
        });

        html += '</tbody></table></div>';
        lista.innerHTML = html;
        bindGfPagar();
        bindGfRevertir();
        bindGfEdit();
    }

    function loadGastosFijos() {
        fetch(GF_DATA_URL + '?anio=' + gfAnio + '&mes=' + gfMes, {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        }).then(function(r) { return r.json(); }).then(renderGastosFijos).catch(function() {
            document.getElementById('gf-lista').innerHTML = '<p class="text-danger small p-3">Error al cargar gastos fijos.</p>';
        });
    }

    // ── Tipo de gasto fijo ───────────────────────────────────────────────────
    function gfSetTipo(tipo) {
        document.getElementById('gf-tipo').value = tipo;
        document.querySelectorAll('.js-gf-tipo').forEach(function(b) {
            var activo = b.dataset.tipo === tipo;
            b.classList.toggle('btn-primary', activo);
            b.classList.toggle('text-white', activo);
            b.style.borderColor = activo ? '' : '#334155';
            b.style.background  = activo ? '' : 'transparent';
        });

        var esFinanciado = tipo === 'financiado' || tipo === 'prestamo';
        document.getElementById('gf-bloque-financiamiento').style.display = esFinanciado ? '' : 'none';
        document.getElementById('gf-bloque-monto-simple').style.display   = esFinanciado ? 'none' : '';

        var labelMap = { financiado: 'Datos del financiamiento (compra a crédito)', prestamo: 'Datos del préstamo' };
        if (labelMap[tipo]) document.getElementById('gf-financiamiento-label').textContent = labelMap[tipo];

        // Para préstamo no hay monto post-financiamiento (termina solo)
        document.getElementById('gf-post-fin-wrap').style.display = tipo === 'financiado' ? '' : 'none';

        // Descripción orientativa por tipo
        var descs = {
            generico:   '<strong>Servicio o gasto recurrente simple.</strong> Agua, luz, gym, cable, internet. ' +
                        'El servicio existe aunque no pagues (solo te cortan). Puede registrar precio por unidad ' +
                        '(ej: botellones de agua a L 45 c/u).',
            financiado: '<strong>Compra a crédito sin interés.</strong> Artículo con prima inicial + cuotas ' +
                        'que pueden variar por tramos. Ej: iPhone en Claro (cuotas 1-4 diferentes a 5-18). ' +
                        'Al terminar el financiamiento puede quedar solo el plan de consumo.',
            prestamo:   '<strong>Préstamo bancario o personal.</strong> El interés varía cada cuota según el ' +
                        'saldo decreciente. Ej: Cooperativa Guadalupe, ITA, préstamo personal. ' +
                        'La tabla de amortización se genera automáticamente.',
            suscripcion:'<strong>Suscripción digital.</strong> Se cancela automáticamente si no pagás. ' +
                        'Ej: Netflix, Spotify, YouTube Premium, Adobe. Activa recordatorio antes del vencimiento ' +
                        'para no perder acceso.',
        };
        var descEl = document.getElementById('gf-tipo-desc');
        descEl.innerHTML = descs[tipo] || '';
    }

    document.querySelectorAll('.js-gf-tipo').forEach(function(btn) {
        btn.addEventListener('click', function() { gfSetTipo(btn.dataset.tipo); });
    });

    // ── Tramos de cuotas especiales ──────────────────────────────────────────
    var gfTramos = [];

    function renderTramos() {
        var lista = document.getElementById('gf-tramos-lista');
        if (gfTramos.length === 0) {
            lista.innerHTML = '<div class="small text-muted" style="font-size:11px;">Sin tramos — todas las cuotas usan el monto base.</div>';
            document.getElementById('gf-cuotas-especiales').value = '';
            return;
        }

        var html = '<div class="table-responsive"><table class="table table-sm mb-1" style="font-size:12px;"><thead><tr>'
            + '<th>Cuota desde</th><th>Cuota hasta</th><th>Monto (L)</th><th></th></tr></thead><tbody>';
        gfTramos.forEach(function(t, i) {
            html += '<tr>'
                + '<td><input type="number" class="form-control form-control-sm" value="' + t.desde + '" min="1" onchange="gfTramos[' + i + '].desde=parseInt(this.value);syncTramos();" style="width:70px;"></td>'
                + '<td><input type="number" class="form-control form-control-sm" value="' + t.hasta + '" min="1" onchange="gfTramos[' + i + '].hasta=parseInt(this.value);syncTramos();" style="width:70px;"></td>'
                + '<td><input type="number" class="form-control form-control-sm" value="' + t.monto + '" min="0.01" step="0.01" onchange="gfTramos[' + i + '].monto=parseFloat(this.value);syncTramos();" style="width:100px;"></td>'
                + '<td><button type="button" class="btn btn-link btn-sm text-danger p-0" onclick="gfTramos.splice(' + i + ',1);renderTramos();" title="Quitar"><i class="bi bi-x-lg"></i></button></td>'
                + '</tr>';
        });
        html += '</tbody></table></div>';
        lista.innerHTML = html;
        syncTramos();
    }

    function syncTramos() {
        document.getElementById('gf-cuotas-especiales').value = gfTramos.length > 0 ? JSON.stringify(gfTramos) : '';
    }

    document.getElementById('btn-gf-add-tramo').addEventListener('click', function() {
        var meses = parseInt(document.getElementById('gf-meses-financiamiento').value) || 12;
        var ultimo = gfTramos.length > 0 ? gfTramos[gfTramos.length - 1].hasta + 1 : 1;
        gfTramos.push({ desde: ultimo, hasta: meses, monto: 0 });
        renderTramos();
    });

    // ── Day Picker ───────────────────────────────────────────────────────────
    function initDayPicker(pickerId, hiddenId, allowClear) {
        var picker = document.getElementById(pickerId);
        var hidden = document.getElementById(hiddenId);
        var html   = '';
        if (allowClear) {
            html += '<button type="button" class="dp-btn dp-clear" data-day="">Ninguno</button>';
        }
        for (var d = 1; d <= 31; d++) {
            html += '<button type="button" class="dp-btn" data-day="' + d + '">' + d + '</button>';
        }
        picker.innerHTML = html;
        picker.addEventListener('click', function (e) {
            var btn = e.target.closest('.dp-btn');
            if (!btn) { return; }
            picker.querySelectorAll('.dp-btn').forEach(function (b) { b.classList.remove('dp-active'); });
            btn.classList.add('dp-active');
            hidden.value = btn.dataset.day;
        });
    }

    function setDayPicker(pickerId, hiddenId, value) {
        var picker = document.getElementById(pickerId);
        var hidden = document.getElementById(hiddenId);
        var strVal = value !== null && value !== undefined ? String(value) : '';
        hidden.value = strVal;
        picker.querySelectorAll('.dp-btn').forEach(function (b) {
            b.classList.toggle('dp-active', b.dataset.day === strVal);
        });
    }

    function setDiaPago(dia) { setDayPicker('gf-dia-pago-picker', 'gf-dia-pago', dia || 1); }
    function setDiaCorte(dia) { setDayPicker('gf-dia-corte-picker', 'gf-dia-corte', dia || ''); }

    initDayPicker('gf-dia-pago-picker', 'gf-dia-pago', false);
    initDayPicker('gf-dia-corte-picker', 'gf-dia-corte', true);
    setDiaPago(1);

    // ── Toggle unidades (tipo simple) ────────────────────────────────────────
    // ── Helpers unidad / presentación (select + "Otro" libre) ───────────────
    function getGfUnidad() {
        var sel = document.getElementById('gf-unidad-sel');
        return sel.value === '__otro__'
            ? document.getElementById('gf-unidad-custom').value.trim()
            : sel.value;
    }
    function setGfUnidad(val) {
        var sel    = document.getElementById('gf-unidad-sel');
        var custom = document.getElementById('gf-unidad-custom');
        var inList = val === '' || Array.from(sel.options).some(function(o) { return o.value === val && o.value !== '__otro__'; });
        if (inList) {
            sel.value = val || '';
            custom.style.display = 'none';
            custom.value = '';
        } else {
            sel.value = '__otro__';
            custom.style.display = '';
            custom.value = val;
        }
    }
    function getGfPresentacion() {
        var sel = document.getElementById('gf-presentacion-sel');
        return sel.value === '__otro__'
            ? document.getElementById('gf-presentacion-custom').value.trim()
            : sel.value;
    }
    function setGfPresentacion(val) {
        var sel    = document.getElementById('gf-presentacion-sel');
        var custom = document.getElementById('gf-presentacion-custom');
        var inList = val === '' || Array.from(sel.options).some(function(o) { return o.value === val && o.value !== '__otro__'; });
        if (inList) {
            sel.value = val || '';
            custom.style.display = 'none';
            custom.value = '';
        } else {
            sel.value = '__otro__';
            custom.style.display = '';
            custom.value = val;
        }
    }
    document.getElementById('gf-unidad-sel').addEventListener('change', function() {
        var custom = document.getElementById('gf-unidad-custom');
        custom.style.display = this.value === '__otro__' ? '' : 'none';
        if (this.value !== '__otro__') { custom.value = ''; }
    });
    document.getElementById('gf-presentacion-sel').addEventListener('change', function() {
        var custom = document.getElementById('gf-presentacion-custom');
        custom.style.display = this.value === '__otro__' ? '' : 'none';
        if (this.value !== '__otro__') { custom.value = ''; }
    });

    // ── Acceso / Pago ────────────────────────────────────────────────────────
    document.querySelector('.js-gf-toggle-acceso').addEventListener('click', function() {
        var bloque   = document.getElementById('gf-bloque-acceso');
        var chevron  = document.querySelector('.js-gf-acceso-chevron');
        var abierto  = bloque.style.display !== 'none';
        bloque.style.display  = abierto ? 'none' : '';
        chevron.style.transform = abierto ? '' : 'rotate(90deg)';
    });
    document.querySelector('.js-gf-toggle-clave').addEventListener('click', function() {
        var inp = document.getElementById('gf-clave-acceso');
        var ico = this.querySelector('i');
        if (inp.type === 'password') { inp.type = 'text';     ico.className = 'bi bi-eye-slash'; }
        else                         { inp.type = 'password'; ico.className = 'bi bi-eye'; }
    });

    function resetGfAcceso() {
        document.getElementById('gf-url-pago').value        = '';
        document.getElementById('gf-numero-cliente').value  = '';
        document.getElementById('gf-usuario-acceso').value  = '';
        document.getElementById('gf-clave-acceso').value    = '';
        document.getElementById('gf-clave-acceso').type     = 'password';
        document.querySelector('.js-gf-toggle-clave i').className = 'bi bi-eye';
        document.getElementById('gf-bloque-acceso').style.display = 'none';
        document.querySelector('.js-gf-acceso-chevron').style.transform = '';
    }

    function restoreGfAcceso(btn) {
        var urlPago       = btn.dataset.urlPago       || '';
        var numeroCliente = btn.dataset.numeroCliente || '';
        var usuarioAcceso = btn.dataset.usuarioAcceso || '';
        var claveAcceso   = btn.dataset.claveAcceso   || '';
        document.getElementById('gf-url-pago').value        = urlPago;
        document.getElementById('gf-numero-cliente').value  = numeroCliente;
        document.getElementById('gf-usuario-acceso').value  = usuarioAcceso;
        document.getElementById('gf-clave-acceso').value    = claveAcceso;
        // Abrir el panel si tiene algún dato
        var tieneAcceso = urlPago || numeroCliente || usuarioAcceso || claveAcceso;
        document.getElementById('gf-bloque-acceso').style.display = tieneAcceso ? '' : 'none';
        document.querySelector('.js-gf-acceso-chevron').style.transform = tieneAcceso ? 'rotate(90deg)' : '';
    }

    function gfToggleUnidades() {
        var activo = document.getElementById('gf-check-unidades').checked;
        document.getElementById('gf-bloque-unidades').style.display = activo ? '' : 'none';
    }

    function gfRecalcMonto() {
        var cant  = parseFloat(document.getElementById('gf-cantidad-base').value);
        var price = parseFloat(document.getElementById('gf-precio-unitario').value);
        if (cant > 0 && price > 0) {
            document.getElementById('gf-monto-simple').value = (cant * price).toFixed(2);
        }
    }

    document.getElementById('gf-check-unidades').addEventListener('change', gfToggleUnidades);
    document.getElementById('gf-cantidad-base').addEventListener('input', gfRecalcMonto);
    document.getElementById('gf-precio-unitario').addEventListener('input', gfRecalcMonto);

    // ── Abrir modal (nuevo) ──────────────────────────────────────────────────
    document.getElementById('btn-nuevo-gasto-fijo').addEventListener('click', function() {
        document.getElementById('gf-mode').value = 'create';
        document.getElementById('modal-gasto-fijo-title').textContent = 'Nuevo gasto fijo';
        document.getElementById('gf-nombre').value               = '';
        document.getElementById('gf-monto').value                = '';
        document.getElementById('gf-monto-simple').value         = '';
        document.getElementById('gf-frecuencia').value           = 'mensual';
        setDiaPago(1);
        setDiaCorte('');
        document.getElementById('gf-check-unidades').checked     = false;
        setGfUnidad('');
        setGfPresentacion('');
        document.getElementById('gf-cantidad-base').value        = '';
        document.getElementById('gf-precio-unitario').value      = '';
        document.getElementById('gf-fecha-inicio-plan').value    = '';
        document.getElementById('gf-meses-financiamiento').value = '';
        document.getElementById('gf-monto-prima').value          = '';
        document.getElementById('gf-monto-post-financiamiento').value = '';
        document.getElementById('gf-cuenta-id').value            = '';
        document.getElementById('gf-category-id').value          = '';
        document.getElementById('gf-nota').value                 = '';
        resetGfAcceso();
        document.getElementById('gf-csrf').value                 = GF_CREATE_TOKEN;
        document.getElementById('gf-edit-url').value             = '';
