{% extends 'workspace/app_layout.html.twig' %}
{% block page_title %}{{ institucion.nombre }}{% endblock %}
{% block app_page_subtitle %}Institución — {{ mes_label }}{% endblock %}

{% block page_styles %}
<style>
.inst-header { background:{{ institucion.color }}18; border:1px solid {{ institucion.color }}55; border-top:3px solid {{ institucion.color }}; border-radius:12px; padding:1.5rem; }
.stat-box { background:#111827; border:1px solid #1e293b; border-radius:10px; padding:1rem 1.25rem; }
body.light-mode .stat-box { background:#fff; border-color:#e2e8f0; }
.stat-label { font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:.06em; }
.stat-value { font-size:22px; font-weight:800; line-height:1.2; margin-top:.2rem; }
.cuenta-mini { background:#111827; border:1px solid #1e293b; border-radius:8px; padding:.75rem 1rem; }
body.light-mode .cuenta-mini { background:#fff; border-color:#e2e8f0; }
.mov-tipo-ingreso { color:#22c55e; font-weight:700; }
.mov-tipo-gasto   { color:#f87171; font-weight:700; }
.chart-wrap { background:#111827; border:1px solid #1e293b; border-radius:10px; padding:1.25rem; }
body.light-mode .chart-wrap { background:#fff; border-color:#e2e8f0; }
.nav-tabs .nav-link { font-size:13px; }
</style>
{% endblock %}

{% block app_main %}

{# ── Breadcrumb ── #}
<nav class="mb-3">
    <a href="{{ path('grova_wallet_index', {_locale: app.request.locale}) }}" class="text-secondary text-decoration-none small">
        <i class="bi bi-wallet2 me-1"></i>Wallet
    </a>
    <span class="text-muted small mx-1">/</span>
    <span class="small text-muted">{{ institucion.nombre }}</span>
</nav>

{# ── Header ── #}
<div class="inst-header mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div style="font-size:22px;font-weight:800;">{{ institucion.nombre }}</div>
            <div class="small text-muted mt-1">{{ cuentas_data|length }} cuenta{{ cuentas_data|length != 1 ? 's' : '' }}</div>
        </div>
        <div class="text-end">
            <div class="stat-label">Saldo total</div>
            <div style="font-size:32px;font-weight:900;" class="{{ total_saldo >= 0 ? 'text-success' : 'text-danger' }}">
                L {{ total_saldo|abs|number_format(2, '.', ',') }}
            </div>
        </div>
    </div>
</div>

{# ── Filtro mes/año ── #}
<div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
    <span class="small text-muted">Período:</span>
    {% for m in 1..12 %}
    <a href="{{ path('grova_wallet_institucion_detalle', {id: institucion.id, _locale: app.request.locale, mes: m, anio: anio}) }}"
       class="btn btn-sm {{ mes == m ? 'btn-primary' : 'btn-outline-secondary' }}">
        {{ meses[m-1]|slice(0,3) }}
    </a>
    {% endfor %}
    <span class="text-muted small">|</span>
    {% for a in (anio - 1)..(anio + 1) %}
    <a href="{{ path('grova_wallet_institucion_detalle', {id: institucion.id, _locale: app.request.locale, mes: mes, anio: a}) }}"
       class="btn btn-sm {{ anio == a ? 'btn-primary' : 'btn-outline-secondary' }}">
        {{ a }}
    </a>
    {% endfor %}
</div>

{# ── Tabs ── #}
<ul class="nav nav-tabs mb-4" id="instTabs">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-resumen">
            <i class="bi bi-grid me-1"></i>Resumen
        </button>
    </li>
    {% for cd in cuentas_data %}
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cuenta-{{ cd.cuenta.id }}">
            {{ cd.cuenta.nombre }}
        </button>
    </li>
    {% endfor %}
</ul>

<div class="tab-content">

    {# ── Tab Resumen ── #}
    <div class="tab-pane fade show active" id="tab-resumen">

        {# Mini-tarjetas por cuenta #}
        <div class="row g-3 mb-4">
            {% for cd in cuentas_data %}
            <div class="col-sm-6 col-lg-4">
                <div class="cuenta-mini" style="border-top:3px solid {{ cd.cuenta.color }};">
                    <div class="small text-muted mb-1">{{ cd.cuenta.tipoLabel }}</div>
                    <div class="fw-bold">{{ cd.cuenta.nombre }}</div>
                    {% if cd.numeroCuenta %}<div class="small text-muted font-monospace">{{ cd.numeroCuenta }}</div>{% endif %}
                    <div class="mt-2 fw-bold {{ cd.saldo >= 0 ? 'text-success' : 'text-danger' }}" style="font-size:18px;">
                        L {{ cd.saldo|abs|number_format(2, '.', ',') }}
                    </div>
                    <div class="small text-muted">Ingresos: L {{ cd.ingresos|number_format(2,'.', ',') }} · Gastos: L {{ cd.gastos|number_format(2,'.', ',') }}</div>
                </div>
            </div>
            {% endfor %}
        </div>

        {# Gráfico comparativo de saldos #}
        {% if cuentas_data|length > 1 %}
        <div class="chart-wrap mb-4">
            <div class="small text-muted mb-3">Comparativo de saldos actuales</div>
            <canvas id="chartSaldos" height="80"></canvas>
        </div>
        {% endif %}

        {# Movimientos consolidados #}
        <div class="content-card">
            <div class="content-card-header">
                Todos los movimientos — {{ mes_label }}
                <span class="badge bg-secondary ms-2">{{ all_movimientos|length }}</span>
            </div>
            <div class="content-card-body p-0">
                {% if all_movimientos|length == 0 %}
                <div class="grova-empty-state py-4">
                    <div class="grova-empty-icon"><i class="bi bi-inbox"></i></div>
                    <div class="grova-empty-title">Sin movimientos</div>
                    <div class="grova-empty-desc">No hay registros para {{ mes_label }}.</div>
                </div>
                {% else %}
                <div class="table-responsive">
                    <table class="table table-sm grova-table mb-0">
                        <thead><tr>
                            <th>Fecha</th><th>Cuenta</th><th>Descripción</th><th>Categoría</th><th class="text-end">Monto</th>
                        </tr></thead>
                        <tbody>
                        {% for item in all_movimientos %}
                        {% set e = item.entry %}
                        {% set c = item.cuenta %}
                        <tr>
                            <td class="text-nowrap small">{{ e.fecha|date('d/m/Y') }}</td>
                            <td><span class="badge" style="background:{{ c.color }}33;color:{{ c.color }};border:1px solid {{ c.color }}44;">{{ c.nombre }}</span></td>
                            <td>{{ e.descripcion ?? '—' }}</td>
                            <td>
                                {% if e.category %}
                                <span class="cat-chip" style="color:{{ e.category.color }};background:{{ e.category.color }}22;">
                                    <i class="{{ e.category.icono }}"></i> {{ e.category.nombre }}
                                </span>
                                {% else %}<span class="text-muted small">—</span>{% endif %}
                            </td>
                            <td class="text-end text-nowrap {{ e.isIngreso ? 'mov-tipo-ingreso' : 'mov-tipo-gasto' }}">
                                {{ e.isIngreso ? '+' : '−' }} L {{ e.montoFloat|number_format(2, '.', ',') }}
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Tabs por cuenta ── #}
    {% for cd in cuentas_data %}
    <div class="tab-pane fade" id="tab-cuenta-{{ cd.cuenta.id }}">

        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="stat-box"><div class="stat-label">Saldo actual</div>
                    <div class="stat-value {{ cd.saldo >= 0 ? 'text-success' : 'text-danger' }}">L {{ cd.saldo|abs|number_format(2,'.', ',') }}</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-box"><div class="stat-label">Ingresos {{ mes_label }}</div>
                    <div class="stat-value text-success">L {{ cd.ingresos|number_format(2,'.', ',') }}</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-box"><div class="stat-label">Gastos {{ mes_label }}</div>
                    <div class="stat-value text-danger">L {{ cd.gastos|number_format(2,'.', ',') }}</div>
                </div>
            </div>
        </div>

        {% if cd.numeroCuenta or cd.tarjeta %}
        <div class="small text-muted mb-3">
            {% if cd.numeroCuenta %}<i class="bi bi-bank me-1"></i>Cta: <span class="font-monospace">{{ cd.numeroCuenta }}</span>{% endif %}
            {% if cd.tarjeta %}&nbsp;&nbsp;<i class="bi bi-credit-card me-1"></i>Tarjeta: <span class="font-monospace">{{ cd.tarjeta }}</span>{% endif %}
        </div>
        {% endif %}

        <div class="chart-wrap mb-4">
            <div class="small text-muted mb-3">Ingresos vs Gastos — {{ mes_label }} (por semana)</div>
            <canvas id="chart-cuenta-{{ cd.cuenta.id }}" height="90"
                    data-semanas="{{ cd.semanas|json_encode }}"></canvas>
        </div>

        <div class="content-card">
            <div class="content-card-header">Movimientos — {{ mes_label }}<span class="badge bg-secondary ms-2">{{ cd.movimientos|length }}</span></div>
            <div class="content-card-body p-0">
                {% if cd.movimientos|length == 0 %}
                <div class="grova-empty-state py-3">
                    <div class="grova-empty-icon"><i class="bi bi-inbox"></i></div>
                    <div class="grova-empty-title">Sin movimientos</div>
                </div>
                {% else %}
                <div class="table-responsive">
                    <table class="table table-sm grova-table mb-0">
                        <thead><tr><th>Fecha</th><th>Descripción</th><th>Categoría</th><th class="text-end">Monto</th></tr></thead>
                        <tbody>
                        {% for e in cd.movimientos %}
                        <tr>
                            <td class="text-nowrap small">{{ e.fecha|date('d/m/Y') }}</td>
                            <td>{{ e.descripcion ?? '—' }}</td>
                            <td>
                                {% if e.category %}
                                <span class="cat-chip" style="color:{{ e.category.color }};background:{{ e.category.color }}22;">
                                    <i class="{{ e.category.icono }}"></i> {{ e.category.nombre }}
                                </span>
                                {% else %}<span class="text-muted small">—</span>{% endif %}
                            </td>
                            <td class="text-end text-nowrap {{ e.isIngreso ? 'mov-tipo-ingreso' : 'mov-tipo-gasto' }}">
                                {{ e.isIngreso ? '+' : '−' }} L {{ e.montoFloat|number_format(2, '.', ',') }}
                            </td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}

</div>{# /tab-content #}
{% endblock %}

{% block app_page_scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    var isDark     = !document.body.classList.contains('light-mode');
    var gridColor  = isDark ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.07)';
    var textColor  = isDark ? '#94a3b8' : '#64748b';

    // Gráfico comparativo de saldos
    var chartSaldosEl = document.getElementById('chartSaldos');
    if (chartSaldosEl) {
        var labels  = {{ cuentas_data|map(cd => cd.cuenta.nombre)|json_encode|raw }};
        var saldos  = {{ cuentas_data|map(cd => cd.saldo)|json_encode|raw }};
        var colors  = {{ cuentas_data|map(cd => cd.cuenta.color)|json_encode|raw }};

        new Chart(chartSaldosEl, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Saldo actual',
                    data: saldos,
                    backgroundColor: colors.map(function(c) { return c + '99'; }),
                    borderColor: colors,
                    borderWidth: 1,
                    borderRadius: 4,
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: textColor }, grid: { color: gridColor } },
                    y: { ticks: { color: textColor, callback: function(v) { return 'L ' + v.toLocaleString(); } }, grid: { color: gridColor } }
                }
            }
        });
    }

    // Gráficos semanales por cuenta
    document.querySelectorAll('[id^="chart-cuenta-"]').forEach(function(canvas) {
        var semanas  = JSON.parse(canvas.dataset.semanas);
        var labels   = ['Sem 1 (1-7)', 'Sem 2 (8-14)', 'Sem 3 (15-21)', 'Sem 4 (22+)'];
        var keys     = ['S1', 'S2', 'S3', 'S4'];
        var ingresos = keys.map(function(k) { return semanas[k].ingreso; });
        var gastos   = keys.map(function(k) { return semanas[k].gasto; });

        new Chart(canvas, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Ingresos', data: ingresos, backgroundColor: '#22c55e99', borderColor: '#22c55e', borderWidth: 1, borderRadius: 4 },
                    { label: 'Gastos',   data: gastos,   backgroundColor: '#f8717199', borderColor: '#f87171', borderWidth: 1, borderRadius: 4 },
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { labels: { color: textColor, font: { size: 12 } } } },
                scales: {
                    x: { ticks: { color: textColor }, grid: { color: gridColor } },
                    y: { ticks: { color: textColor, callback: function(v) { return 'L ' + v.toLocaleString(); } }, grid: { color: gridColor } }
                }
            }
        });
    });
})();
</script>
{% endblock %}
