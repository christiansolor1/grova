{% extends 'workspace/app_layout.html.twig' %}
{% block page_title %}Banca{% endblock %}
{% block app_page_subtitle %}Mis cuentas y saldos{% endblock %}

{% block page_styles %}
<style>
.banca-total { background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%); border:1px solid #334155; border-radius:14px; padding:1.75rem 2rem; }
body.light-mode .banca-total { background:linear-gradient(135deg,#f1f5f9 0%,#e2e8f0 100%); border-color:#cbd5e1; }

.inst-group { border:1px solid #1e293b; border-radius:12px; overflow:hidden; margin-bottom:1.25rem; }
body.light-mode .inst-group { border-color:#e2e8f0; }
.inst-group-header { display:flex; align-items:center; justify-content:space-between; padding:.9rem 1.25rem; background:#111827; border-bottom:1px solid #1e293b; }
body.light-mode .inst-group-header { background:#f8fafc; border-bottom-color:#e2e8f0; }
.inst-group-header .inst-nombre { font-weight:700; font-size:15px; }
.inst-group-header .inst-saldo { font-size:18px; font-weight:800; }

.cuenta-row { display:flex; align-items:center; justify-content:space-between; padding:.75rem 1.25rem; border-bottom:1px solid #1e293b11; text-decoration:none; color:inherit; transition:background .12s; }
body.light-mode .cuenta-row { border-bottom-color:#e2e8f022; }
.cuenta-row:hover { background:#ffffff08; }
body.light-mode .cuenta-row:hover { background:#0000000a; }
.cuenta-row:last-child { border-bottom:none; }

.cuenta-dot { width:10px; height:10px; border-radius:50%; display:inline-block; flex-shrink:0; }
.cuenta-tipo-badge { font-size:10px; background:#1e293b; border:1px solid #334155; color:#94a3b8; border-radius:4px; padding:1px 6px; }
body.light-mode .cuenta-tipo-badge { background:#f1f5f9; border-color:#cbd5e1; color:#64748b; }
.cuenta-inactiva { opacity:.45; }

.saldo-positive { color:#22c55e; font-weight:700; }
.saldo-negative { color:#f87171; font-weight:700; }
.saldo-neutral  { color:#94a3b8; font-weight:700; }
.chart-wrap { background:#111827; border:1px solid #1e293b; border-radius:10px; padding:1.25rem; }
body.light-mode .chart-wrap { background:#fff; border-color:#e2e8f0; }
</style>
{% endblock %}

{% block app_main %}

{# ── Breadcrumb ── #}
<nav class="mb-3">
    <a href="{{ path('grova_wallet_index', {_locale: app.request.locale}) }}" class="text-secondary text-decoration-none small">
        <i class="bi bi-wallet2 me-1"></i>Wallet
    </a>
    <span class="text-muted small mx-1">/</span>
    <span class="small text-muted">Banca</span>
</nav>

{# ── Saldo total ── #}
<div class="banca-total mb-4">
    <div class="small text-muted mb-1" style="text-transform:uppercase;letter-spacing:.07em;font-size:11px;">Patrimonio neto estimado</div>
    <div style="font-size:38px;font-weight:900;" class="{{ total_saldo >= 0 ? 'saldo-positive' : 'saldo-negative' }}">
        L {{ total_saldo|abs|number_format(2, '.', ',') }}
    </div>
    <div class="small text-muted mt-1">{{ grupos|length }} grupo{{ grupos|length != 1 ? 's' : '' }} · {{ grupos|map(g => g.cuentas|length)|reduce((carry, v) => carry + v, 0) }} cuenta{{ (grupos|map(g => g.cuentas|length)|reduce((carry, v) => carry + v, 0)) != 1 ? 's' : '' }}</div>
</div>

{# ── Gráfico saldo por cuenta ── #}
{% if grupos|length > 0 %}
<div class="chart-wrap mb-4">
    <div class="small text-muted mb-3">Saldo por cuenta</div>
    <canvas id="chartBanca" height="80"
            data-labels="{{ grupos|map(g => g.cuentas|map(c => (g.institucion ? g.institucion.nombre ~ ' · ' : '') ~ c.cuenta.nombre))|reduce((carry, v) => carry|merge(v), [])|json_encode }}"
            data-saldos="{{ grupos|map(g => g.cuentas|map(c => c.cuenta.isCredito ? -(c.saldo) : c.saldo))|reduce((carry, v) => carry|merge(v), [])|json_encode }}"
            data-colors="{{ grupos|map(g => g.cuentas|map(c => c.cuenta.color))|reduce((carry, v) => carry|merge(v), [])|json_encode }}">
    </canvas>
</div>
{% endif %}

{# ── Grupos por institución ── #}
{% for grupo in grupos %}
{% set inst = grupo.institucion %}
<div class="inst-group">

    {# Header del grupo #}
    <div class="inst-group-header" {% if inst %}style="border-top:3px solid {{ inst.color }};"{% else %}style="border-top:3px solid #64748b;"{% endif %}>
        <div class="d-flex align-items-center gap-2">
            {% if inst %}
            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:{{ inst.color }};flex-shrink:0;"></span>
            <a href="{{ path('grova_wallet_institucion_detalle', {id: inst.id, _locale: app.request.locale}) }}"
               class="inst-nombre text-decoration-none" style="color:{{ inst.color }};">
                {{ inst.nombre }}
                <i class="bi bi-arrow-up-right" style="font-size:11px;opacity:.6;"></i>
            </a>
            {% else %}
            <i class="bi bi-wallet2 text-muted"></i>
            <span class="inst-nombre text-muted">Cartera / Efectivo</span>
            {% endif %}
            <span class="badge bg-secondary ms-1" style="font-size:10px;">{{ grupo.cuentas|length }}</span>
        </div>
        <div class="inst-saldo {{ grupo.saldo >= 0 ? 'saldo-positive' : 'saldo-negative' }}">
            {{ grupo.saldo >= 0 ? '' : '−' }}L {{ grupo.saldo|abs|number_format(2, '.', ',') }}
        </div>
    </div>

    {# Filas de cuentas #}
    {% for item in grupo.cuentas %}
    {% set cuenta = item.cuenta %}
    <a href="{{ path('grova_wallet_cuenta_detalle', {id: cuenta.id, _locale: app.request.locale}) }}"
       class="cuenta-row {{ cuenta.activo ? '' : 'cuenta-inactiva' }}">

        <div class="d-flex align-items-center gap-3">
            <span class="cuenta-dot" style="background:{{ cuenta.color }};"></span>
            <div>
                <div class="fw-semibold" style="font-size:14px;">{{ cuenta.nombre }}</div>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="cuenta-tipo-badge">{{ cuenta.tipoLabel }}</span>
                    {% if not cuenta.activo %}<span class="cuenta-tipo-badge text-danger" style="border-color:#f87171;">Inactiva</span>{% endif %}
                </div>
            </div>
        </div>

        <div class="text-end">
            {% set s = item.saldo %}
            <div class="{{ s > 0 ? 'saldo-positive' : (s < 0 ? 'saldo-negative' : 'saldo-neutral') }}" style="font-size:16px;">
                {% if cuenta.isCredito %}
                    {# Crédito: positivo = deuda #}
                    {% if s > 0 %}<span class="text-danger">Debes L {{ s|number_format(2,'.', ',') }}</span>{% else %}<span class="text-success">Sin deuda</span>{% endif %}
                {% else %}
                    {{ s >= 0 ? '' : '−' }}L {{ s|abs|number_format(2,'.', ',') }}
                {% endif %}
            </div>
            <div class="small text-muted" style="font-size:11px;">saldo actual</div>
        </div>

    </a>
    {% endfor %}

</div>
{% else %}
<div class="grova-empty-state">
    <div class="grova-empty-icon"><i class="bi bi-bank"></i></div>
    <div class="grova-empty-title">Sin cuentas</div>
    <div class="grova-empty-desc">Crea tu primera cuenta desde <a href="{{ path('grova_wallet_index', {_locale: app.request.locale}) }}">Wallet</a>.</div>
</div>
{% endfor %}

{% endblock %}

{% block app_page_scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    var canvas = document.getElementById('chartBanca');
    if (!canvas) { return; }

    var isDark    = !document.body.classList.contains('light-mode');
    var gridColor = isDark ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.07)';
    var textColor = isDark ? '#94a3b8' : '#64748b';

    var labels = JSON.parse(canvas.dataset.labels);
    var saldos = JSON.parse(canvas.dataset.saldos);
    var colors = JSON.parse(canvas.dataset.colors);

    new Chart(canvas, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Saldo',
                data: saldos,
                backgroundColor: colors.map(function(c) { return c + '99'; }),
                borderColor: colors,
                borderWidth: 1,
                borderRadius: 4,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { color: textColor, font: { size: 11 } }, grid: { color: gridColor } },
                y: {
                    ticks: { color: textColor, callback: function(v) { return 'L ' + v.toLocaleString(); } },
                    grid: { color: gridColor }
                }
            }
        }
    });
})();
</script>
{% endblock %}
