{# Contenido interno de #work-inv-proof-cell-{id} (fragmento para include y respuestas AJAX). #}
{% set inv_can_toggle_paid = invoice.anio == vigente_year %}

{# ── Slot 1: Comprobante TASARAUTO (cliente) ── #}
{% if invoice.pagadaAt %}
    {% if inv_can_toggle_paid %}
        {% if invoice.paymentProofStoredFilename %}
            <div class="inv-proof-actions d-inline-flex align-items-center gap-1 me-2">
                <a href="{{ path('grova_work_invoice_payment_proof', {id: invoice.id, _locale: locale}) }}"
                   target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline-secondary btn-sm btn-inv-proof"
                   title="Comprobante TASARAUTO — ver">
                    <i class="bi bi-building me-1"></i><i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('grova_work_invoice_payment_proof', {id: invoice.id, _locale: locale}) }}"
                   download="{{ invoice.paymentProofOriginalName ?: 'comprobante-tasarauto' }}"
                   class="btn btn-outline-secondary btn-sm btn-inv-proof"
                   title="Comprobante TASARAUTO — descargar">
                    <i class="bi bi-download"></i>
                </a>
                <form method="post"
                      action="{{ path('grova_work_invoice_payment_proof_delete', {id: invoice.id, _locale: locale}) }}"
                      class="d-inline js-work-proof-delete mb-0"
                      data-invoice-id="{{ invoice.id }}"
                      data-confirm-title="{{ 'work.payment_proof_delete_confirm_title'|trans({}, 'work') }}"
                      data-confirm-text="{{ 'work.payment_proof_delete_confirm_text'|trans({}, 'work') }}">
                    <input type="hidden" name="invoice_year" value="{{ invoice_year }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('work_invoice_payment_proof_delete_' ~ invoice.id) }}">
                    <button type="submit" class="btn btn-outline-danger btn-sm btn-inv-proof border-0" title="{{ 'work.payment_proof_delete'|trans({}, 'work') }}">
                        <i class="bi bi-trash3"></i>
                    </button>
                </form>
            </div>
        {% else %}
            <button type="button"
                    class="btn btn-outline-secondary btn-sm btn-inv-proof js-work-proof-upload-open me-2"
                    data-bs-toggle="modal"
                    data-bs-target="#modal-work-payment-proof"
                    data-invoice-id="{{ invoice.id }}"
                    data-proof-action="{{ path('grova_work_invoice_payment_proof', {id: invoice.id, _locale: locale}) }}"
                    data-proof-token="{{ csrf_token('work_invoice_payment_proof_' ~ invoice.id) }}"
                    data-proof-period-text="{{ 'work.modal_payment_proof_period_label'|trans({'%period%': work_month_year(invoice.anio, invoice.mes)}, 'work')|e('html_attr') }}"
                    title="Subir comprobante TASARAUTO">
                <i class="bi bi-building me-1"></i><i class="bi bi-cloud-upload"></i>
            </button>
        {% endif %}
    {% else %}
        {% if invoice.paymentProofStoredFilename %}
            <div class="inv-proof-actions d-inline-flex align-items-center gap-1 me-2">
                <a href="{{ path('grova_work_invoice_payment_proof', {id: invoice.id, _locale: locale}) }}"
                   target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline-secondary btn-sm btn-inv-proof"
                   title="Comprobante TASARAUTO — ver">
                    <i class="bi bi-building me-1"></i><i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('grova_work_invoice_payment_proof', {id: invoice.id, _locale: locale}) }}"
                   download="{{ invoice.paymentProofOriginalName ?: 'comprobante-tasarauto' }}"
                   class="btn btn-outline-secondary btn-sm btn-inv-proof"
                   title="Comprobante TASARAUTO — descargar">
                    <i class="bi bi-download"></i>
                </a>
            </div>
        {% else %}
            <span class="text-muted small me-2" title="Sin comprobante TASARAUTO">—</span>
        {% endif %}
    {% endif %}
{% else %}
    <span class="text-muted small" title="{{ 'work.payment_proof_col_pending_invoice'|trans({}, 'work') }}">—</span>
{% endif %}

{# ── Slot 2: Comprobante banco (conversión EUR→L) ── #}
{% if invoice.pagadaAt %}
    {% if inv_can_toggle_paid %}
        {% if invoice.bankProofStoredFilename %}
            <div class="inv-proof-actions d-inline-flex align-items-center gap-1">
                <a href="{{ path('grova_work_invoice_bank_proof', {id: invoice.id, _locale: locale}) }}"
                   target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline-success btn-sm btn-inv-proof"
                   title="Comprobante banco — ver">
                    <i class="bi bi-bank2 me-1"></i><i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('grova_work_invoice_bank_proof', {id: invoice.id, _locale: locale}) }}"
                   download="{{ invoice.bankProofOriginalName ?: 'comprobante-banco' }}"
                   class="btn btn-outline-success btn-sm btn-inv-proof"
                   title="Comprobante banco — descargar">
                    <i class="bi bi-download"></i>
                </a>
                <form method="post"
                      action="{{ path('grova_work_invoice_bank_proof_delete', {id: invoice.id, _locale: locale}) }}"
                      class="d-inline js-work-proof-delete mb-0"
                      data-invoice-id="{{ invoice.id }}"
                      data-confirm-title="Eliminar comprobante banco"
                      data-confirm-text="¿Eliminar el comprobante del banco?">
                    <input type="hidden" name="invoice_year" value="{{ invoice_year }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('work_invoice_bank_proof_delete_' ~ invoice.id) }}">
                    <button type="submit" class="btn btn-outline-danger btn-sm btn-inv-proof border-0" title="Eliminar comprobante banco">
                        <i class="bi bi-trash3"></i>
                    </button>
                </form>
            </div>
        {% else %}
            <button type="button"
                    class="btn btn-outline-success btn-sm btn-inv-proof js-work-bank-proof-open"
                    data-bs-toggle="modal"
                    data-bs-target="#modal-work-bank-proof"
                    data-invoice-id="{{ invoice.id }}"
                    data-period="{{ work_month_year(invoice.anio, invoice.mes) }}"
                    data-lempiras="{{ invoice.lempirasRecibidosFloat > 0 ? invoice.lempirasRecibidosFloat|number_format(2, '.', '') : '' }}"
                    data-comision="{{ invoice.comisionBancoHnl ?? invoice.client.recargoHnl ?? '0.00' }}"
                    data-swift="{{ invoice.reciboSwift ?? '' }}"
                    data-bank-action="{{ path('grova_work_invoice_bank_proof', {id: invoice.id, _locale: locale}) }}"
                    data-bank-token="{{ csrf_token('work_invoice_bank_proof_' ~ invoice.id) }}"
                    title="Subir comprobante banco">
                <i class="bi bi-bank2 me-1"></i><i class="bi bi-cloud-upload"></i>
            </button>
        {% endif %}
    {% else %}
        {% if invoice.bankProofStoredFilename %}
            <div class="inv-proof-actions d-inline-flex align-items-center gap-1">
                <a href="{{ path('grova_work_invoice_bank_proof', {id: invoice.id, _locale: locale}) }}"
                   target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline-success btn-sm btn-inv-proof"
                   title="Comprobante banco — ver">
                    <i class="bi bi-bank2 me-1"></i><i class="bi bi-eye"></i>
                </a>
                <a href="{{ path('grova_work_invoice_bank_proof', {id: invoice.id, _locale: locale}) }}"
                   download="{{ invoice.bankProofOriginalName ?: 'comprobante-banco' }}"
                   class="btn btn-outline-success btn-sm btn-inv-proof"
                   title="Comprobante banco — descargar">
                    <i class="bi bi-download"></i>
                </a>
            </div>
        {% else %}
            <span class="text-muted small">—</span>
        {% endif %}
    {% endif %}
{% endif %}
