                {% endif %}

                <hr style="border-color:#1e293b;">
                <p style="font-size:12px;font-weight:600;color:#94a3b8;margin-bottom:.5rem;">Subir nuevo documento</p>
                <form method="post" action="{{ path('grova_financiera_documento_subir', {_locale: app.request.locale}) }}" enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ csrf_token('fin_documento') }}">
                    <input type="hidden" name="entidad_tipo" value="inversion">
                    <input type="hidden" name="entidad_id" value="{{ inv.id }}">
                    <div class="mb-2">
                        <input type="file" name="archivo" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" required>
                        <div style="font-size:11px;color:#64748b;margin-top:.25rem;">PDF, JPG, PNG o WEBP · máx. 10 MB</div>
                    </div>
                    <div class="mb-3">
                        <input type="text" name="descripcion" class="form-control form-control-sm" placeholder="Descripción opcional (ej: Contrato de compraventa)">
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-upload me-1"></i>Subir</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}

{% endblock %}

{% block app_scripts %}
<script>
function finTab(panel, btn) {
    document.getElementById('fin-panel-gastos').style.display   = 'none';
    document.getElementById('fin-panel-ingresos').style.display = 'none';
    document.getElementById('fin-panel-' + panel).style.display = '';
    document.querySelectorAll('.fin-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}
function toggleIngTC() {
    var moneda = document.getElementById('ing-moneda').value;
    var wrap   = document.getElementById('ing-tc-wrap');
    wrap.style.display = moneda !== 'HNL' ? '' : 'none';
}
function toggleGtoTC() {
    var moneda = document.getElementById('gto-moneda').value;
    var tc     = document.getElementById('gto-tc');
    tc.readOnly = moneda === 'HNL';
    if (moneda === 'HNL') tc.value = '1';
}
</script>
{% endblock %}
