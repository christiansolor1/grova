{# ── Modales: Documentos compromisos ── #}
{% for c in compromisos %}
{% set compDocs = documentos['compromiso'][c.id] ?? [] %}
<div class="modal fade" id="modal-doc-comp-{{ c.id }}" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-size:14px;"><i class="bi bi-paperclip me-2"></i>Documentos — {{ c.nombre }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                {% if compDocs is not empty %}
                <ul class="fin-doc-list mb-3">
                    {% for d in compDocs %}
                    <li class="fin-doc-item">
                        <i class="bi bi-{{ d.esPdf ? 'file-earmark-pdf text-danger' : 'image text-info' }}" style="font-size:14px;flex-shrink:0;"></i>
                        <a href="{{ path('grova_financiera_documento_ver', {_locale: app.request.locale, id: d.id}) }}" target="_blank" title="{{ d.nombreOriginal }}">{{ d.nombreOriginal }}</a>
                        {% if d.descripcion %}<span class="fin-doc-desc">{{ d.descripcion }}</span>{% endif %}
                        <span class="fin-doc-size">{{ d.tamanoLegible() }}</span>
                        <form method="post" action="{{ path('grova_financiera_documento_eliminar', {_locale: app.request.locale, id: d.id}) }}" class="d-inline ms-auto" onsubmit="return confirm('¿Eliminar este documento?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('fin_doc_del_' ~ d.id) }}">
                            <button type="submit" class="btn btn-link p-0 text-danger" style="font-size:13px;"><i class="bi bi-trash3"></i></button>
                        </form>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="text-muted mb-3" style="font-size:13px;">Sin documentos aún.</p>
                {% endif %}

                <hr style="border-color:#1e293b;">
                <p style="font-size:12px;font-weight:600;color:#94a3b8;margin-bottom:.5rem;">Subir nuevo documento</p>
                <form method="post" action="{{ path('grova_financiera_documento_subir', {_locale: app.request.locale}) }}" enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ csrf_token('fin_documento') }}">
                    <input type="hidden" name="entidad_tipo" value="compromiso">
                    <input type="hidden" name="entidad_id" value="{{ c.id }}">
                    <div class="mb-2">
                        <input type="file" name="archivo" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.webp" required>
                        <div style="font-size:11px;color:#64748b;margin-top:.25rem;">PDF, JPG, PNG o WEBP · máx. 10 MB</div>
                    </div>
                    <div class="mb-3">
                        <input type="text" name="descripcion" class="form-control form-control-sm" placeholder="Descripción opcional (ej: Recibo cuota #1)">
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-upload me-1"></i>Subir</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}

