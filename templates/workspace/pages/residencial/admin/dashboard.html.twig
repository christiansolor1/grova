{% extends 'workspace/app_layout.html.twig' %}
{% block page_title %}Residencial{% endblock %}
{% block app_page_subtitle %}Panel de control del residencial{% endblock %}

{% block page_styles %}
<style>
.res-stat { background:#111827; border:1px solid #1e293b; border-radius:12px; padding:1.25rem; }
body.light-mode .res-stat { background:#fff; border-color:#e2e8f0; }
.res-stat-label { font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.35rem; }
.res-stat-value { font-size:32px; font-weight:800; }
.res-card { background:#111827; border:1px solid #1e293b; border-radius:12px; padding:1.25rem; }
body.light-mode .res-card { background:#fff; border-color:#e2e8f0; }
</style>
{% endblock %}

{% block app_main %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} mb-3">{{ message }}</div>
    {% endfor %}
{% endfor %}

{% if residencial is null %}
{# ── Onboarding: aún no hay residencial configurado ── #}
<div class="content-card">
    <div class="content-card-body text-center py-5">
        <i class="bi bi-house-door" style="font-size:3rem;color:#3b82f6;"></i>
        <h5 class="mt-3">Configura tu residencial</h5>
        <p class="text-muted">Aún no tienes un residencial configurado. Completa los datos básicos para empezar.</p>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalConfigurar">
            <i class="bi bi-gear me-1"></i>Configurar ahora
        </button>
    </div>
</div>
{% else %}

{# ── Stats ── #}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="res-stat">
            <div class="res-stat-label">Entradas hoy</div>
            <div class="res-stat-value" style="color:#4ade80;">{{ entradas_hoy }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="res-stat">
            <div class="res-stat-label">Visitantes dentro</div>
            <div class="res-stat-value" style="color:#38bdf8;">{{ visitantes_activos }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="res-stat">
            <div class="res-stat-label">Paquetes pendientes</div>
            <div class="res-stat-value" style="color:#fbbf24;">{{ paquetes_pendientes }}</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="res-stat">
            <div class="res-stat-label">Incidentes del mes</div>
            <div class="res-stat-value" style="color:#f87171;">{{ incidentes_mes }}</div>
        </div>
    </div>
</div>

{# ── Accesos rápidos ── #}
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="res-card">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <strong>{{ residencial.nombre }}</strong>
                <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalConfigurar">
                    <i class="bi bi-gear me-1"></i>Editar
                </button>
            </div>
            <div class="row g-2">
                <div class="col-sm-6 col-md-3">
                    <a href="{{ path('grova_residencial_guardia_garita', {_locale: app.request.locale}) }}" class="btn btn-outline-success w-100">
                        <i class="bi bi-shield-check me-1"></i>Abrir garita
                    </a>
                </div>
                <div class="col-sm-6 col-md-3">
                    <a href="{{ path('grova_residencial_admin_casas', {_locale: app.request.locale}) }}" class="btn btn-outline-primary w-100">
                        <i class="bi bi-houses me-1"></i>Ver casas
                    </a>
                </div>
                <div class="col-sm-6 col-md-3">
                    <a href="{{ path('grova_residencial_admin_paquetes', {_locale: app.request.locale}) }}" class="btn btn-outline-warning w-100">
                        <i class="bi bi-box-seam me-1"></i>Paquetes
                    </a>
                </div>
                <div class="col-sm-6 col-md-3">
                    <a href="{{ path('grova_residencial_admin_mapa', {_locale: app.request.locale}) }}" class="btn btn-outline-info w-100">
                        <i class="bi bi-map me-1"></i>Editor de mapa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% endif %}

{# ── Modal configurar residencial ── #}
<div class="modal fade" id="modalConfigurar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('grova_residencial_admin_configurar', {_locale: app.request.locale}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('residencial_config') }}">
                <div class="modal-header">
                    <h5 class="modal-title">Configurar residencial</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" required
                               value="{{ residencial ? residencial.nombre : '' }}" placeholder="Residencial Las Palmas">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <input type="text" name="direccion" class="form-control"
                               value="{{ residencial ? residencial.direccion : '' }}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input type="text" name="telefono" class="form-control"
                               value="{{ residencial ? residencial.telefono : '' }}">
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">Latitud</label>
                            <input type="text" name="coordenadas_lat" class="form-control"
                                   value="{{ residencial ? residencial.coordenadasLat : '' }}" placeholder="14.0818">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Longitud</label>
                            <input type="text" name="coordenadas_lng" class="form-control"
                                   value="{{ residencial ? residencial.coordenadasLng : '' }}" placeholder="-87.2068">
                        </div>
                    </div>
                    <div class="small text-muted mt-1">Las coordenadas se usan para el botón "Cómo llegar" en la vista del pase.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}
