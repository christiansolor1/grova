{% extends 'workspace/app_layout.html.twig' %}
{% block page_title %}Entrada manual{% endblock %}
{% block app_page_subtitle %}Registrar entrada sin QR{% endblock %}

{% block app_main %}

<div class="content-card" style="max-width:600px;">
    <div class="content-card-header">
        <a href="{{ path('grova_residencial_guardia_garita', {_locale: app.request.locale}) }}" class="btn btn-sm btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i>
        </a>
        Entrada manual
    </div>
    <div class="content-card-body">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('residencial_entrada_manual') }}">

            <div class="mb-3">
                <label class="form-label">Nombre completo del visitante</label>
                <input type="text" name="nombre_completo" class="form-control" required>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label">DNI / Identidad</label>
                    <input type="text" name="dni" class="form-control" placeholder="Busca si ya existe">
                </div>
                <div class="col-6">
                    <label class="form-label">Teléfono</label>
                    <input type="text" name="telefono" class="form-control">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Casa destino</label>
                <select name="casa_id" class="form-select">
                    <option value="0">— Selecciona una casa —</option>
                    {% for casa in casas %}
                        <option value="{{ casa.id }}">{{ casa.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Guardia que registra</label>
                <select name="guardia_id" class="form-select" required>
                    <option value="0">— Selecciona guardia —</option>
                    {% for guardia in guardias %}
                        <option value="{{ guardia.id }}">{{ guardia.nombreCompleto }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Observaciones</label>
                <textarea name="observaciones" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('grova_residencial_guardia_garita', {_locale: app.request.locale}) }}" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-check me-1"></i>Registrar entrada
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}
