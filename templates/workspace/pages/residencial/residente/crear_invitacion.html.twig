{% extends 'workspace/app_layout.html.twig' %}
{% block page_title %}Nueva invitación{% endblock %}
{% block app_page_subtitle %}Genera un pase QR para tu visitante{% endblock %}

{% block app_main %}

<div class="content-card" style="max-width:580px;">
    <div class="content-card-header">
        <a href="{{ path('grova_residencial_residente_index', {_locale: app.request.locale}) }}" class="btn btn-sm btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i>
        </a>
        Nueva invitación
        {% if casa %}
            <span class="ms-2 small text-muted">→ {{ casa.label }}</span>
        {% endif %}
    </div>
    <div class="content-card-body">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('residencial_pase') }}">

            <div class="mb-3">
                <label class="form-label fw-semibold">Datos del visitante</label>
                <div class="row g-2">
                    <div class="col-12">
                        <input type="text" name="visitante_nombre" class="form-control" required
                               placeholder="Nombre completo del visitante">
                    </div>
                    <div class="col-6">
                        <input type="text" name="visitante_dni" class="form-control"
                               placeholder="DNI (opcional)">
                    </div>
                    <div class="col-6">
                        <input type="text" name="visitante_telefono" class="form-control"
                               placeholder="Teléfono (opcional)">
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Tipo de acceso</label>
                <select name="tipo" class="form-select" id="tipo-pase">
                    <option value="unica_vez">Única vez</option>
                    <option value="recurrente">Recurrente (varios días/semanas)</option>
                    <option value="permanente">Permanente</option>
                </select>
            </div>

            <div id="bloque-fechas" class="mb-3">
                <label class="form-label fw-semibold">Vigencia</label>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small">Desde</label>
                        <input type="date" name="fecha_inicio" class="form-control"
                               value="{{ 'now'|date('Y-m-d') }}">
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Hasta</label>
                        <input type="date" name="fecha_fin" class="form-control">
                    </div>
                </div>
            </div>

            <div id="bloque-horario" class="mb-3">
                <label class="form-label fw-semibold">Horario permitido <span class="text-muted fw-normal">(opcional)</span></label>
                <div class="row g-2">
                    <div class="col-6">
                        <input type="time" name="hora_inicio" class="form-control" placeholder="08:00">
                    </div>
                    <div class="col-6">
                        <input type="time" name="hora_fin" class="form-control" placeholder="18:00">
                    </div>
                </div>
            </div>

            <div id="bloque-dias" class="mb-3" style="display:none;">
                <label class="form-label fw-semibold">Días permitidos</label>
                <div class="d-flex gap-2 flex-wrap">
                    {% set dias = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'] %}
                    {% for i in 0..6 %}
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="dias_semana[]" value="{{ i }}" id="dia{{ i }}"
                               {{ i in [1,2,3,4,5] ? 'checked' : '' }}>
                        <label class="form-check-label" for="dia{{ i }}">{{ dias[i] }}</label>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <a href="{{ path('grova_residencial_residente_index', {_locale: app.request.locale}) }}"
                   class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-qr-code me-1"></i>Generar invitación
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block app_page_scripts %}
<script>
document.getElementById('tipo-pase').addEventListener('change', function () {
    const tipo = this.value;
    document.getElementById('bloque-dias').style.display = tipo === 'recurrente' ? '' : 'none';
});
</script>
{% endblock %}
