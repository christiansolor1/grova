{% extends 'base.html.twig' %}

{% block title %}Grova – Instalación inicial{% endblock %}

{% block stylesheets %}
<style>
    body {
        background: #0b1020;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
    }
    .setup-wrapper { width: 100%; max-width: 560px; }
    .setup-card {
        background: #111827;
        border: 1px solid #1f2937;
        border-radius: 12px;
        overflow: hidden;
    }
    .setup-header {
        padding: 1.5rem 1.75rem 1rem;
        border-bottom: 1px solid #1f2937;
    }
    .setup-logo-box {
        width: 44px; height: 44px;
        background: #2563eb;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; color: #fff; font-size: 1.15rem;
        flex-shrink: 0;
    }
    .setup-title { color: #f1f5f9; font-weight: 700; font-size: 1.45rem; letter-spacing: -0.3px; }
    .setup-subtitle { color: #9ca3af; font-size: .88rem; margin-top: .15rem; }
    .setup-body { padding: 1.75rem; }

    /* Steps indicator */
    .steps-indicator {
        display: flex;
        align-items: center;
        gap: 0;
        margin-top: 1.1rem;
    }
    .step-dot {
        width: 28px; height: 28px;
        border-radius: 50%;
        background: #1f2937;
        border: 2px solid #374151;
        display: flex; align-items: center; justify-content: center;
        font-size: .75rem; font-weight: 700; color: #6b7280;
        flex-shrink: 0;
        transition: all .25s;
    }
    .step-dot.active { background: #2563eb; border-color: #2563eb; color: #fff; }
    .step-dot.done { background: #16a34a; border-color: #16a34a; color: #fff; }
    .step-line {
        flex: 1; height: 2px;
        background: #1f2937;
        transition: background .25s;
    }
    .step-line.done { background: #16a34a; }

    /* Step labels */
    .steps-labels {
        display: flex;
        justify-content: space-between;
        margin-top: .4rem;
    }
    .step-label {
        font-size: .7rem;
        color: #6b7280;
        text-align: center;
        width: 28px;
        transition: color .25s;
    }
    .step-label.active { color: #93c5fd; }
    .step-label.done { color: #86efac; }

    /* Form styles */
    .form-label { color: #cbd5e1; font-size: .88rem; font-weight: 600; margin-bottom: .4rem; }
    .form-control, .input-group-text {
        background: #0f172a;
        border-color: #1f2937;
        color: #f1f5f9;
        border-radius: 8px;
    }
    .form-control:focus {
        background: #0f172a;
        border-color: #2563eb;
        color: #f1f5f9;
        box-shadow: 0 0 0 3px rgba(37,99,235,.2);
    }
    .form-control::placeholder { color: #64748b; }
    .form-text { color: #64748b; font-size: .78rem; }
    .input-group-text { color: #64748b; border-radius: 8px 0 0 8px !important; }
    .input-group .form-control { border-radius: 0 8px 8px 0 !important; }
    .is-invalid { border-color: #ef4444 !important; }
    .invalid-feedback { color: #fca5a5; font-size: .8rem; display: block; margin-top: .25rem; }
    .alert-install-error {
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.3);
        color: #fca5a5;
        border-radius: 8px;
        font-size: .85rem;
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 200px;
        overflow-y: auto;
    }

    /* Step panels */
    .step-panel { display: none; }
    .step-panel.active { display: block; }

    .step-heading {
        font-size: 1.05rem;
        font-weight: 700;
        color: #f1f5f9;
        margin-bottom: .25rem;
    }
    .step-desc {
        font-size: .85rem;
        color: #9ca3af;
        margin-bottom: 1.25rem;
    }

    /* Buttons */
    .btn-grova {
        background: #2563eb;
        border: none;
        font-weight: 600;
        padding: .75rem 1.5rem;
        font-size: .95rem;
        border-radius: 8px;
        color: #fff;
        transition: background .2s;
    }
    .btn-grova:hover { background: #1d4ed8; color: #fff; }
    .btn-grova:disabled { background: #1e40af; opacity: .7; }
    .btn-back {
        background: transparent;
        border: 1px solid #374151;
        font-weight: 600;
        padding: .75rem 1.25rem;
        font-size: .95rem;
        border-radius: 8px;
        color: #9ca3af;
        transition: all .2s;
    }
    .btn-back:hover { border-color: #6b7280; color: #f1f5f9; }
    .nav-buttons { display: flex; gap: .75rem; margin-top: 1.5rem; }
    .nav-buttons .btn-grova { flex: 1; }
</style>
{% endblock %}

{% block body %}
{% set f = form|default({}) %}
<div class="setup-wrapper">
    <div class="setup-card shadow-lg">

        <div class="setup-header">
            <div class="d-flex align-items-center gap-3">
                <div class="setup-logo-box">G</div>
                <div>
                    <div class="setup-title">Instalar Grova</div>
                    <div class="setup-subtitle" id="header-subtitle">Paso 1 de 3 — Base de datos</div>
                </div>
            </div>
            <div class="steps-indicator mt-3">
                <div class="step-dot active" id="dot-1">1</div>
                <div class="step-line" id="line-1"></div>
                <div class="step-dot" id="dot-2">2</div>
                <div class="step-line" id="line-2"></div>
                <div class="step-dot" id="dot-3">3</div>
            </div>
            <div class="steps-labels">
                <span class="step-label active" id="label-1">BD</span>
                <span class="step-label" id="label-2">Admin</span>
                <span class="step-label" id="label-3">Workspace</span>
            </div>
        </div>

        <div class="setup-body">
            {% if errors.install is defined %}
                <div class="alert alert-install-error mb-4 px-3 py-2">
                    <i class="bi bi-exclamation-triangle me-2"></i>{{ errors.install }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_setup_install') }}" id="setup-form" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('grova_setup') }}">

                {# ── PASO 1: Base de datos ── #}
                <div class="step-panel active" id="step-1">
                    <div class="step-heading">Base de datos</div>
                    <div class="step-desc">¿Dónde está tu servidor MySQL / MariaDB?</div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="db_host" class="form-label">Host</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-hdd-network"></i></span>
                                <input type="text" class="form-control{% if errors.db_host is defined %} is-invalid{% endif %}"
                                       id="db_host" name="db_host" value="{{ f.db_host|default('127.0.0.1') }}"
                                       placeholder="127.0.0.1" required>
                            </div>
                            {% if errors.db_host is defined %}<div class="invalid-feedback">{{ errors.db_host }}</div>{% endif %}
                        </div>
                        <div class="col-md-4">
                            <label for="db_port" class="form-label">Puerto</label>
                            <input type="number" class="form-control" id="db_port" name="db_port"
                                   value="{{ f.db_port|default('3306') }}" min="1" max="65535">
                        </div>
                        <div class="col-12">
                            <label for="db_name" class="form-label">Nombre de la base de datos</label>
                            <input type="text" class="form-control{% if errors.db_name is defined %} is-invalid{% endif %}"
                                   id="db_name" name="db_name" value="{{ f.db_name|default('grova_core') }}"
                                   placeholder="grova_core" required pattern="[a-zA-Z0-9_]+">
                            {% if errors.db_name is defined %}<div class="invalid-feedback">{{ errors.db_name }}</div>{% endif %}
                        </div>
                        <div class="col-md-6">
                            <label for="db_user" class="form-label">Usuario</label>
                            <input type="text" class="form-control{% if errors.db_user is defined %} is-invalid{% endif %}"
                                   id="db_user" name="db_user" value="{{ f.db_user|default('') }}"
                                   autocomplete="off" required>
                            {% if errors.db_user is defined %}<div class="invalid-feedback">{{ errors.db_user }}</div>{% endif %}
                        </div>
                        <div class="col-md-6">
                            <label for="db_password" class="form-label">Contraseña</label>
                            <input type="password" class="form-control{% if errors.db_password is defined %} is-invalid{% endif %}"
                                   id="db_password" name="db_password"
                                   autocomplete="new-password" placeholder="••••••••">
                            {% if errors.db_password is defined %}<div class="invalid-feedback">{{ errors.db_password }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="nav-buttons">
                        <button type="button" class="btn btn-grova" onclick="irPaso(2)">
                            Siguiente <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>

                {# ── PASO 2: Superusuario ── #}
                <div class="step-panel" id="step-2">
                    <div class="step-heading">Tu cuenta de administrador</div>
                    <div class="step-desc">Será el superusuario con acceso total a Grova.</div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="admin_username" class="form-label">Nombre de usuario</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" class="form-control{% if errors.admin_username is defined %} is-invalid{% endif %}"
                                       id="admin_username" name="admin_username" value="{{ f.admin_username|default('') }}"
                                       placeholder="ej. christiansolorzano" required autocomplete="username">
                            </div>
                            {% if errors.admin_username is defined %}<div class="invalid-feedback">{{ errors.admin_username }}</div>{% endif %}
                        </div>
                        <div class="col-12">
                            <label for="admin_email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control{% if errors.admin_email is defined %} is-invalid{% endif %}"
                                       id="admin_email" name="admin_email" value="{{ f.admin_email|default('') }}"
                                       placeholder="admin@tuempresa.com" required autocomplete="email">
                            </div>
                            {% if errors.admin_email is defined %}<div class="invalid-feedback">{{ errors.admin_email }}</div>{% endif %}
                        </div>
                        <div class="col-md-6">
                            <label for="admin_password" class="form-label">Contraseña</label>
                            <input type="password" class="form-control{% if errors.admin_password is defined %} is-invalid{% endif %}"
                                   id="admin_password" name="admin_password" required minlength="8"
                                   autocomplete="new-password" placeholder="Mínimo 8 caracteres">
                            {% if errors.admin_password is defined %}<div class="invalid-feedback">{{ errors.admin_password }}</div>{% endif %}
                        </div>
                        <div class="col-md-6">
                            <label for="admin_password_confirm" class="form-label">Confirmar contraseña</label>
                            <input type="password" class="form-control{% if errors.admin_password_confirm is defined %} is-invalid{% endif %}"
                                   id="admin_password_confirm" name="admin_password_confirm" required
                                   autocomplete="new-password" placeholder="••••••••">
                            {% if errors.admin_password_confirm is defined %}<div class="invalid-feedback">{{ errors.admin_password_confirm }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="nav-buttons">
                        <button type="button" class="btn btn-back" onclick="irPaso(1)">
                            <i class="bi bi-arrow-left me-1"></i> Atrás
                        </button>
                        <button type="button" class="btn btn-grova" onclick="irPaso(3)">
                            Siguiente <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>

                {# ── PASO 3: Workspace ── #}
                <div class="step-panel" id="step-3">
                    <div class="step-heading">Tu empresa o workspace</div>
                    <div class="step-desc">¿Cómo se llama tu organización?</div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="workspace_name" class="form-label">Nombre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                                <input type="text" class="form-control{% if errors.workspace_name is defined %} is-invalid{% endif %}"
                                       id="workspace_name" name="workspace_name" value="{{ f.workspace_name|default('') }}"
                                       placeholder="Mi Empresa S.A." required>
                            </div>
                            {% if errors.workspace_name is defined %}<div class="invalid-feedback">{{ errors.workspace_name }}</div>{% endif %}
                        </div>
                    </div>
                    <div class="nav-buttons">
                        <button type="button" class="btn btn-back" onclick="irPaso(2)">
                            <i class="bi bi-arrow-left me-1"></i> Atrás
                        </button>
                        <button type="submit" class="btn btn-grova" id="btn-install">
                            <span id="btn-text"><i class="bi bi-rocket-takeoff me-2"></i>Instalar Grova</span>
                            <span id="btn-spinner" class="spinner-border spinner-border-sm d-none ms-2" role="status"></span>
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
const subtitulos = [
    'Paso 1 de 3 — Base de datos',
    'Paso 2 de 3 — Cuenta de administrador',
    'Paso 3 de 3 — Workspace',
];

function irPaso(n) {
    // Validación básica antes de avanzar
    if (n > pasoActual && !validarPaso(pasoActual)) return;

    // Ocultar panel actual
    document.getElementById('step-' + pasoActual).classList.remove('active');

    // Actualizar dots
    for (let i = 1; i <= 3; i++) {
        const dot = document.getElementById('dot-' + i);
        const lbl = document.getElementById('label-' + i);
        dot.classList.remove('active', 'done');
        lbl.classList.remove('active', 'done');
        if (i < n) { dot.classList.add('done'); lbl.classList.add('done'); }
        if (i === n) { dot.classList.add('active'); lbl.classList.add('active'); }
    }

    // Líneas
    for (let i = 1; i <= 2; i++) {
        const line = document.getElementById('line-' + i);
        line.classList.toggle('done', i < n);
    }

    pasoActual = n;
    document.getElementById('step-' + n).classList.add('active');
    document.getElementById('header-subtitle').textContent = subtitulos[n - 1];
}

function validarPaso(paso) {
    let ok = true;

    if (paso === 1) {
        ok = requerido('db_host') & requerido('db_name') & requerido('db_user');
    } else if (paso === 2) {
        ok = requerido('admin_username') & requerido('admin_email') & requerido('admin_password') & confirmarPass();
    }

    return ok;
}

function requerido(id) {
    const el = document.getElementById(id);
    if (!el.value.trim()) {
        el.classList.add('is-invalid');
        return false;
    }
    el.classList.remove('is-invalid');
    return true;
}

function confirmarPass() {
    const p1 = document.getElementById('admin_password');
    const p2 = document.getElementById('admin_password_confirm');
    if (p1.value.length < 8) {
        p1.classList.add('is-invalid');
        return false;
    }
    if (p1.value !== p2.value) {
        p2.classList.add('is-invalid');
        return false;
    }
    p1.classList.remove('is-invalid');
    p2.classList.remove('is-invalid');
    return true;
}

let pasoActual = {{ errors is not empty ? '1' : '1' }};

// Si hay errores de servidor, ir al paso correcto
{% if errors is not empty %}
    {% if errors.db_host is defined or errors.db_name is defined or errors.db_user is defined or errors.db_password is defined %}
        pasoActual = 1;
    {% elseif errors.admin_username is defined or errors.admin_email is defined or errors.admin_password is defined or errors.admin_password_confirm is defined %}
        irPaso(2);
    {% elseif errors.workspace_name is defined %}
        irPaso(3);
    {% endif %}
{% endif %}

document.getElementById('setup-form').addEventListener('submit', function () {
    if (!validarPaso(3)) { return; }
    const btn = document.getElementById('btn-install');
    const text = document.getElementById('btn-text');
    const spinner = document.getElementById('btn-spinner');
    btn.disabled = true;
    text.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Instalando…';
    spinner.classList.remove('d-none');
});
</script>
{% endblock %}
